{
  "name": "cebulion-casino-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Narzędzia front-endu Cebulion Casino: wendorowanie PixiJS i fontów, serwer atrapy API, testy e2e. Aplikacja NIE potrzebuje Node.js do działania (pliki wynikowe są w repozytorium).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node vendor.mjs",
    "dev": "node dev/mock-api.mjs",
    "dev:pusty": "node dev/mock-api.mjs --pusty",
    "e2e": "node e2e/smoke.mjs",
    "e2e:gra": "node e2e/gra-s1.mjs",
    "e2e:s2": "node e2e/gra-s2.mjs",
    "e2e:s3": "node e2e/gra-s3.mjs",
    "e2e:runtime": "node e2e/runtime-contract.mjs",
    "e2e:audio": "node e2e/audio-lifecycle.mjs",
    "e2e:backend": "node e2e/backend-flow.mjs",
    "e2e:wygrane": "node e2e/audit-win-timing.mjs",
    "e2e:srodki": "node e2e/funds-modal.mjs",
    "e2e:debug": "node e2e/debug-scenarios.mjs"
  },
  "devDependencies": {
    "@fontsource/bungee": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cinzel-decorative": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "pixi.js": "8.22.0",
    "playwright-core": "1.56.1"
  }
}

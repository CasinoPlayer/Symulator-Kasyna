@@ -0,0 +1,51 @@
+package pl.wsb.kasyno.slots.application.engine;
+
+import com.fasterxml.jackson.annotation.JsonSubTypes;
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.annotation.JsonTypeName;
+
+/**
+ * Pojedyncza wygrana w kroku {@link RoundStep.Win} (kontrakt API § 2.4, pole {@code kind}).
+ *
+ * <p>Jak liczymy kwoty (zawsze liczby całkowite, ułamki w dół):
+ * <ul>
+ *   <li>linia: mnożnik z tabeli × (zakład / liczba linii) × {@code wildMultiplier} × {@code freeSpinMultiplier};</li>
+ *   <li>scatter i klaster: mnożnik z tabeli × zakład całkowity.</li>
+ * </ul>
+ */
+@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, include = JsonTypeInfo.As.PROPERTY, property = "kind")
+@JsonSubTypes({
+        @JsonSubTypes.Type(WinItem.Line.class),
+        @JsonSubTypes.Type(WinItem.Scatter.class),
+        @JsonSubTypes.Type(WinItem.Cluster.class)
+})
+public sealed interface WinItem {
+
+    /** Kwota tej wygranej w cebulionach. */
+    long amount();
+
+    /**
+     * Wygrana na linii.
+     *
+     * @param line               numer linii od 1 (indeks w {@code paylines} + 1)
+     * @param symbol             kod symbolu, który płaci (WILD zastępuje inne symbole)
+     * @param count              ile kolejnych symboli od lewej
+     * @param positions          pozycje wygrywających symboli
+     * @param wildMultiplier     1 albo 2 (S1 „neonowy mnożnik”: WILD na wygrywającej linii)
+     * @param freeSpinMultiplier 1 albo 2 (S2: wygrane w darmowych spinach)
+     */
+    @JsonTypeName("line")
+    record Line(int line, String symbol, int count, int[][] positions, long amount, int wildMultiplier,
+                int freeSpinMultiplier) implements WinItem {
+    }
+
+    /** Wygrana za scattery w dowolnym miejscu planszy. */
+    @JsonTypeName("scatter")
+    record Scatter(String symbol, int count, int[][] positions, long amount) implements WinItem {
+    }
+
+    /** Wygrana klastrowa S3: {@code size} takich samych symboli połączonych bokami. */
+    @JsonTypeName("cluster")
+    record Cluster(String symbol, int size, int[][] positions, long amount) implements WinItem {
+    }
+}
diff --git a/src/main/java/pl/wsb/kasyno/slots/domain/Paylines.java b/src/main/java/pl/wsb/kasyno/slots/domain/Paylines.java
new file mode 100644
index 0000000..aa7252e
--- /dev/null
+++ b/src/main/java/pl/wsb/kasyno/slots/domain/Paylines.java
@@ -0,0 +1,77 @@
+package pl.wsb.kasyno.slots.domain;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+import java.util.stream.Collectors;
+
+/**
+ * Linie wygrywające automatu liniowego (obiekt wartości, niemodyfikowalny). Każda linia to lista indeksów rzędów
+ * (0 = górny) dla kolejnych bębnów, np. środkowa linia 3 bębnów to {@code [1,1,1]}, skośna {@code [0,1,2]}.
+ * Numer linii w wygranych = indeks na liście + 1 (kontrakt API § 2.2).
+ *
+ * <p>Zapis w bazie: kolumna tekstowa (konwerter {@link PaylinesConverter}), linie rozdzielone {@code |}, rzędy
+ * przecinkami: {@code "1,1,1|0,0,0|2,2,2|0,1,2|2,1,0"}. Uzasadnienie kolumny zamiast tabeli jak w
+ * {@link ReelStrips}: linie zawsze czytamy w całości razem z automatem, a ich kolejność ma znaczenie (numer linii).
+ */
+public final class Paylines {
+
+    private final List<List<Integer>> lines;
+
+    private Paylines(List<List<Integer>> lines) {
+        if (lines.isEmpty()) {
+            throw new IllegalArgumentException("Automat liniowy musi mieć co najmniej jedną linię");
+        }
+        int length = lines.getFirst().size();
+        for (List<Integer> line : lines) {
+            if (line.size() != length || line.stream().anyMatch(row -> row < 0)) {
+                throw new IllegalArgumentException("Linie muszą mieć tę samą długość i nieujemne rzędy: " + lines);
+            }
+        }
+        this.lines = lines.stream().map(List::copyOf).toList();
+    }
+
+    public static Paylines of(List<List<Integer>> lines) {
+        return new Paylines(lines);
+    }
+
+    /** Odczyt z tekstu {@code "1,1,1|0,0,0"}. */
+    public static Paylines parse(String text) {
+        if (text == null || text.isBlank()) {
+            throw new IllegalArgumentException("Brak linii wygrywających");
+        }
+        return new Paylines(Arrays.stream(text.split("\\|"))
+                .map(line -> Arrays.stream(line.split(",")).map(String::strip).map(Integer::valueOf).toList())
+                .toList());
+    }
+
+    /** Zapis do tekstu {@code "1,1,1|0,0,0"}. */
+    public String toText() {
+        return lines.stream()
+                .map(line -> line.stream().map(String::valueOf).collect(Collectors.joining(",")))
+                .collect(Collectors.joining("|"));
+    }
+
+    public int count() {
+        return lines.size();
+    }
+
+    public List<List<Integer>> asList() {
+        return lines;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+        return other instanceof Paylines that && lines.equals(that.lines);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(lines);
+    }
+
+    @Override
+    public String toString() {
+        return toText();
+    }
+}
diff --git a/src/main/java/pl/wsb/kasyno/slots/domain/PaylinesConverter.java b/src/main/java/pl/wsb/kasyno/slots/domain/PaylinesConverter.java
new file mode 100644
index 0000000..1dde50d
--- /dev/null
+++ b/src/main/java/pl/wsb/kasyno/slots/domain/PaylinesConverter.java
@@ -0,0 +1,22 @@
+package pl.wsb.kasyno.slots.domain;
+
+import jakarta.persistence.AttributeConverter;
+import jakarta.persistence.Converter;
+
+/**
+ * Konwerter JPA: kolumna tekstowa {@code "1,1,1|0,0,0"} ↔ obiekt {@link Paylines}. Pusta kolumna oznacza grę
+ * bez linii (klastrową).
+ */
+@Converter
+public class PaylinesConverter implements AttributeConverter<Paylines, String> {
+
+    @Override
+    public String convertToDatabaseColumn(Paylines paylines) {
+        return paylines == null ? null : paylines.toText();
+    }
+
+    @Override
+    public Paylines convertToEntityAttribute(String column) {
+        return column == null || column.isBlank() ? null : Paylines.parse(column);
+    }
+}
diff --git a/src/main/java/pl/wsb/kasyno/slots/domain/ReelStrips.java b/src/main/java/pl/wsb/kasyno/slots/domain/ReelStrips.java
new file mode 100644
index 0000000..018f3be
--- /dev/null
+++ b/src/main/java/pl/wsb/kasyno/slots/domain/ReelStrips.java
@@ -0,0 +1,85 @@
+package pl.wsb.kasyno.slots.domain;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+import java.util.stream.Collectors;
+
+/**
+ * Taśmy bębnów automatu liniowego (obiekt wartości, niemodyfikowalny): dla każdego bębna lista kodów symboli
+ * w kolejności, w jakiej są nadrukowane na taśmie. Taśma jest „pętlą”: po ostatnim symbolu wraca pierwszy.
+ *
+ * <p>Jak działa losowanie: silnik losuje dla każdego bębna pozycję zatrzymania {@code 0..długość-1}, a w oknie
+ * automatu widać kolejne {@code rows} symbole od tej pozycji. Częstość symbolu = ile razy jest na taśmie
+ * / długość taśmy, więc taśmy (a nie same wagi) decydują o matematyce gry i o tym, które symbole sąsiadują.
+ *
+ * <p>Zapis w bazie: jedna kolumna tekstowa (konwerter {@link ReelStripsConverter}), bębny rozdzielone {@code |},
+ * symbole przecinkami, np. {@code "wisnie,bar,wild|cytryna,...|..."}. Dlaczego kolumna w {@code slot_machine},
+ * a nie osobna tabela {@code reel_stop(automat, bęben, pozycja, symbol)}:
+ * <ul>
+ *   <li>taśmy czytamy zawsze w całości i razem z automatem (silnik potrzebuje wszystkich naraz), nigdy nie szukamy
+ *       „pozycji 17 bębna 3”, więc tabela nic nie daje, a kosztuje ~550 wierszy i sortowanie po pozycji;</li>
+ *   <li>kolejność symboli jest częścią danych: w kolumnie tekstowej jest zachowana wprost, w tabeli trzeba by
+ *       pilnować kolumny {@code pozycja} i {@code ORDER BY};</li>
+ *   <li>ta sama decyzja co dla {@link BetLevels}: brak siódmej tabeli bez własnej logiki i brak zapytań N+1;</li>
+ *   <li>cała konfiguracja gry jest w {@code data.sql} w jednym miejscu, łatwa do porównania z dokumentacją.</li>
+ * </ul>
+ * Kody symboli muszą istnieć w {@code slot_symbol} tej gry; sprawdza to silnik przy wczytaniu konfiguracji.
+ */
+public final class ReelStrips {
+
+    private final List<List<String>> reels;
+
+    private ReelStrips(List<List<String>> reels) {
+        if (reels.isEmpty() || reels.stream().anyMatch(List::isEmpty)) {
+            throw new IllegalArgumentException("Każdy bęben musi mieć co najmniej jeden symbol");
+        }
+        this.reels = reels.stream().map(List::copyOf).toList();
+    }
+
+    public static ReelStrips of(List<List<String>> reels) {
+        return new ReelStrips(reels);
+    }
+
+    /** Odczyt z tekstu {@code "a,b,c|d,e,f"} (spacje i znaki nowej linii dookoła kodów są ignorowane). */
+    public static ReelStrips parse(String text) {
+        if (text == null || text.isBlank()) {
+            throw new IllegalArgumentException("Brak taśm bębnów");
+        }
+        return new ReelStrips(Arrays.stream(text.split("\\|"))
+                .map(reel -> Arrays.stream(reel.split(",")).map(String::strip).filter(s -> !s.isEmpty()).toList())
+                .toList());
+    }
+
+    /** Zapis do tekstu {@code "a,b,c|d,e,f"}. */
+    public String toText() {
+        return reels.stream().map(reel -> String.join(",", reel)).collect(Collectors.joining("|"));
+    }
+
+    public int reelCount() {
+        return reels.size();
+    }
+
+    public List<String> reel(int index) {
+        return reels.get(index);
+    }
+
+    public List<List<String>> asList() {
+        return reels;
+    }
+
+    @Override
+    public boolean equals(Object other) {

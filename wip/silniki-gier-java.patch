@@ -0,0 +1,39 @@
+package pl.wsb.kasyno.slots.application.engine;
+
+/**
+ * Zasady gry liniowej, które nie są „danymi” (te są w {@code data.sql}: symbole, wypłaty, taśmy, linie), tylko
+ * regułami funkcji specjalnych. Jeden {@link LinesEngine} obsługuje dwie różne gry właśnie dzięki temu rekordowi:
+ * <ul>
+ *   <li>Cebulowy 777: {@code wildLineMultiplier = 2} („neonowy mnożnik”), {@code fullScreenMultiplier = 10}
+ *       („NEON JACKPOT”), bez darmowych spinów, limit 1 000×;</li>
+ *   <li>Złoty Faraon: darmowe spiny z rozszerzającym się WILD i wygranymi ×2, limit 5 000×.</li>
+ * </ul>
+ *
+ * @param wildLineMultiplier       mnożnik wygranej linii, na której WILD zastąpił symbol (1 = brak)
+ * @param fullScreenMultiplier     mnożnik, gdy cała siatka to jeden symbol (z WILD); 0 albo 1 = funkcja wyłączona
+ * @param freeSpins                zasady darmowych spinów albo {@code null} (gra bez darmowych spinów)
+ * @param expandingWildInFreeSpins czy w darmowych spinach WILD rozszerza się na cały bęben
+ * @param freeSpinWinMultiplier    mnożnik wygranych liniowych w darmowych spinach (1 = brak)
+ * @param maxWinMultiplier         maksymalna wygrana rundy jako wielokrotność zakładu
+ * @param anticipation             kiedy front ma spowolnić ostatnie bębny („prawie wygrana”)
+ */
+public record LinesRules(int wildLineMultiplier, int fullScreenMultiplier, FreeSpinsRules freeSpins,
+                         boolean expandingWildInFreeSpins, int freeSpinWinMultiplier, int maxWinMultiplier,
+                         Anticipation anticipation) {
+
+    public LinesRules {
+        if (wildLineMultiplier < 1 || freeSpinWinMultiplier < 1 || maxWinMultiplier < 1 || anticipation == null) {
+            throw new IllegalArgumentException("Niepoprawne zasady gry liniowej");
+        }
+    }
+
+    /** Reguła antycypacji (zdarzenie E27 z briefu: spowolnienie bębnów, gdy „prawie” jest bonus). */
+    public enum Anticipation {
+        /** Bez spowolnienia. */
+        NONE,
+        /** S1: na jakiejś linii WILD stoi na wszystkich bębnach poza ostatnim → spowolnij ostatni bęben. */
+        WILDS_ON_LINE,
+        /** S2: o jeden scatter za mało do darmowych spinów → spowolnij wszystkie kolejne bębny. */
+        SCATTERS
+    }
+}
diff --git a/src/main/java/pl/wsb/kasyno/slots/application/engine/RandomSource.java b/src/main/java/pl/wsb/kasyno/slots/application/engine/RandomSource.java
new file mode 100644
index 0000000..74393de
--- /dev/null
+++ b/src/main/java/pl/wsb/kasyno/slots/application/engine/RandomSource.java
@@ -0,0 +1,26 @@
+package pl.wsb.kasyno.slots.application.engine;
+
+/**
+ * Źródło liczb losowych <b>wewnątrz jednej rundy</b>. Silniki gier losują wyłącznie przez ten interfejs.
+ *
+ * <p>Po co interfejs zamiast {@code new Random()} w silniku:
+ * <ul>
+ *   <li>w aplikacji runda dostaje {@link SplittableRandomSource} zbudowany z ziarna rundy, więc ten sam seed
+ *       zawsze daje ten sam przebieg (odtwarzalność, audyt, testy);</li>
+ *   <li>w testach można podać „ustawione” liczby (np. pozycje zatrzymania bębnów) i sprawdzić konkretny układ:
+ *       WILD na linii, klaster 5 pól, rozszerzenie WILD w darmowych spinach.</li>
+ * </ul>
+ * Ziarno rundy pochodzi z {@link SeedGenerator} ({@link java.security.SecureRandom}, 64 bity): jest nieprzewidywalne
+ * dla gracza, a mimo to po fakcie pozwala odtworzyć rundę.
+ */
+@FunctionalInterface
+public interface RandomSource {
+
+    /** Liczba losowa z przedziału {@code [0, bound)}, każda wartość z tym samym prawdopodobieństwem. */
+    int nextInt(int bound);
+
+    /** Generator rundy dla podanego ziarna (to samo ziarno → te same liczby). */
+    static RandomSource fromSeed(long seed) {
+        return new SplittableRandomSource(seed);
+    }
+}
diff --git a/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundBuilder.java b/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundBuilder.java
new file mode 100644
index 0000000..b7e3036
--- /dev/null
+++ b/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundBuilder.java
@@ -0,0 +1,85 @@
+package pl.wsb.kasyno.slots.application.engine;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Zbiera kroki jednej rundy i pilnuje sumy wygranej oraz limitu maksymalnej wygranej.
+ *
+ * <p>Po co: wszystkie miejsca, które dodają wygraną (linie, klastry, NEON JACKPOT, kule mnożników), przechodzą przez
+ * {@link #addWin(long)}. Dzięki temu suma narastająca {@code totalWin} w krokach jest zawsze spójna z wynikiem rundy,
+ * a limit (np. 5 000× zakładu w Złotym Faraonie) jest sprawdzany w jednym miejscu: kwota ponad limit jest ucinana,
+ * runda dostaje krok {@code feature} {@code maxWin} i silnik kończy ją (bez dalszych kaskad i darmowych spinów).
+ * Ograniczenie wygranej to standard w automatach: zamyka „ogon” rozkładu, więc najgorszy przypadek dla kasyna jest znany.
+ */
+final class RoundBuilder {
+
+    private final long maxWin;
+    private final int maxWinMultiplier;
+    private final List<RoundStep> steps = new ArrayList<>();
+    private long totalWin;
+    private boolean maxWinReached;
+    private boolean freeSpinsTriggered;
+    private int freeSpinsPlayed;
+    private long freeSpinsWin;
+
+    RoundBuilder(long bet, int maxWinMultiplier) {
+        this.maxWin = Math.multiplyExact(bet, maxWinMultiplier);
+        this.maxWinMultiplier = maxWinMultiplier;
+    }
+
+    void add(RoundStep step) {
+        steps.add(step);
+    }
+
+    /**
+     * Dolicza wygraną z uwzględnieniem limitu.
+     *
+     * @return kwota faktycznie dodana (mniejsza od {@code amount}, gdy limit został osiągnięty)
+     */
+    long addWin(long amount) {
+        long allowed = Math.min(amount, maxWin - totalWin);
+        totalWin += allowed;
+        if (totalWin >= maxWin) {
+            maxWinReached = true;
+        }
+        return allowed;
+    }
+
+    /** Wygrana zdobyta w darmowym spinie (do podsumowania {@code freeSpinsEnd}). */
+    void addFreeSpinsWin(long amount) {
+        freeSpinsWin += amount;
+    }
+
+    /** Jeśli limit został osiągnięty, dopisuje krok {@code feature maxWin} i zwraca {@code true} (koniec rundy). */
+    boolean stopAtMaxWin() {
+        if (maxWinReached) {
+            steps.add(new RoundStep.Feature(RoundStep.MAX_WIN, maxWinMultiplier, null, null));
+        }
+        return maxWinReached;
+    }
+
+    boolean maxWinReached() {
+        return maxWinReached;
+    }
+
+    void freeSpinsTriggered() {
+        freeSpinsTriggered = true;
+    }
+
+    void freeSpinPlayed() {
+        freeSpinsPlayed++;
+    }
+
+    long totalWin() {
+        return totalWin;
+    }
+
+    long freeSpinsWin() {
+        return freeSpinsWin;
+    }
+
+    RoundResult build() {
+        return new RoundResult(totalWin, steps, freeSpinsTriggered, freeSpinsPlayed, freeSpinsWin, maxWinReached);
+    }
+}
diff --git a/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundJson.java b/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundJson.java
new file mode 100644
index 0000000..b2283cf
--- /dev/null
+++ b/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundJson.java
@@ -0,0 +1,39 @@
+package pl.wsb.kasyno.slots.application.engine;
+
+import com.fasterxml.jackson.annotation.JsonInclude;
+import com.fasterxml.jackson.core.JsonProcessingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.json.JsonMapper;
+
+import java.util.List;
+
+/**
+ * Zamiana kroków rundy na JSON {@code {"steps":[...]}} (część odpowiedzi spinu z kontraktu § 2.4; resztę pól,
+ * np. saldo, dokleja {@code SpinService}).
+ *
+ * <p>Własny, prywatny {@link ObjectMapper} zamiast beana ze Springa: silnik ma działać tak samo w aplikacji
+ * i w zwykłym teście JUnit (bez kontekstu Springa), a format kroków nie może zależeć od globalnych ustawień
+ * Jacksona. {@code ObjectMapper} po skonfigurowaniu jest bezpieczny wątkowo, więc wystarczy jeden egzemplarz.
+ */
+public final class RoundJson {
+
+    private static final ObjectMapper MAPPER = JsonMapper.builder()
+            .serializationInclusion(JsonInclude.Include.NON_NULL)
+            .build();
+
+    private RoundJson() {
+    }
+
+    /** Dokument {@code {"steps":[...]}} dla listy kroków. */
+    public static String stepsDocument(List<RoundStep> steps) {
+        try {
+            return MAPPER.writeValueAsString(new StepsDocument(steps));
+        } catch (JsonProcessingException e) {
+            throw new IllegalStateException("Nie udało się zapisać kroków rundy jako JSON", e);
+        }
+    }
+
+    /** Opakowanie listy: zadeklarowany typ elementu {@code RoundStep} włącza pole {@code "type"} w każdym kroku. */
+    private record StepsDocument(List<RoundStep> steps) {
+    }
+}
diff --git a/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundResult.java b/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundResult.java
new file mode 100644
index 0000000..28e1ca8
--- /dev/null
+++ b/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundResult.java
@@ -0,0 +1,30 @@
+package pl.wsb.kasyno.slots.application.engine;
+
+import java.util.List;
+
+/**
+ * Pełny wynik rundy policzony przez silnik, zanim zamienimy go na JSON.
+ *
+ * <p>Poza krokami animacji zawiera liczniki potrzebne testom matematyki (Monte Carlo): czy padły darmowe spiny,
+ * ile ich zagrano, ile z nich wygrano i czy runda dobiła do limitu wygranej. Dzięki temu testy RTP sprawdzają
+ * dokładnie ten sam kod, który działa w aplikacji, a nie jego osobną „uproszczoną” kopię.
+ *
+ * @param totalWin           łączna wygrana rundy w cebulionach (z darmowymi spinami, po limicie)
+ * @param steps              kroki animacji w kolejności odgrywania
+ * @param freeSpinsTriggered czy runda uruchomiła darmowe spiny
+ * @param freeSpinsPlayed    ile darmowych spinów zagrano (z dodatkowymi)
+ * @param freeSpinsWin       suma wygranych z darmowych spinów
+ * @param maxWinReached      czy runda zakończyła się na limicie maksymalnej wygranej
+ */
+public record RoundResult(long totalWin, List<RoundStep> steps, boolean freeSpinsTriggered, int freeSpinsPlayed,
+                          long freeSpinsWin, boolean maxWinReached) {
+
+    public RoundResult {
+        steps = List.copyOf(steps);
+    }
+
+    /** Wygrana z gry podstawowej (bez darmowych spinów). */
+    public long baseWin() {
+        return totalWin - freeSpinsWin;
+    }
+}
diff --git a/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundStep.java b/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundStep.java
new file mode 100644
index 0000000..ca8eb24
--- /dev/null
+++ b/src/main/java/pl/wsb/kasyno/slots/application/engine/RoundStep.java
@@ -0,0 +1,107 @@
+package pl.wsb.kasyno.slots.application.engine;
+
+import com.fasterxml.jackson.annotation.JsonSubTypes;
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.annotation.JsonTypeName;
+
+import java.util.List;
+
+/**
+ * Jeden krok animacji rundy: dokładnie format z kontraktu API ({@code docs/projekt/09}, § 2.4). Serwer liczy całą
+ * rundę naraz, a przeglądarka odgrywa kroki po kolei, niczego nie losując ani nie licząc.
+ *
+ * <p>Każdy typ kroku to osobny rekord; Jackson dopisuje pole {@code "type"} (np. {@code "spin"}) na podstawie
+ * {@link JsonTypeName}. Pola {@code null} są pomijane (np. {@code freeSpinIndex} w grze podstawowej, {@code orbs}
+ * w grach liniowych). Siatka zawsze jako {@code grid[bęben][rząd]}, rząd 0 = górny; pozycja to {@code [bęben, rząd]}.
+ * Kroki, które dodają wygraną, mają {@code win} (ile dodał) i {@code totalWin} (suma narastająca rundy).
+ */
+@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, include = JsonTypeInfo.As.PROPERTY, property = "type")
+@JsonSubTypes({
+        @JsonSubTypes.Type(RoundStep.Spin.class),
+        @JsonSubTypes.Type(RoundStep.ExpandWild.class),
+        @JsonSubTypes.Type(RoundStep.Feature.class),
+        @JsonSubTypes.Type(RoundStep.Win.class),
+        @JsonSubTypes.Type(RoundStep.Cascade.class),
+        @JsonSubTypes.Type(RoundStep.ApplyMultiplier.class),
+        @JsonSubTypes.Type(RoundStep.FreeSpinsStart.class),
+        @JsonSubTypes.Type(RoundStep.FreeSpinsRetrigger.class),
+        @JsonSubTypes.Type(RoundStep.FreeSpinsEnd.class)
+})
+public sealed interface RoundStep {
+
+    /** Nazwa funkcji S1 „NEON JACKPOT” w kroku {@link Feature}. */
+    String NEON_JACKPOT = "neonJackpot";
+    /** Nazwa kroku {@link Feature} oznaczającego osiągnięcie maksymalnej wygranej rundy (runda się kończy). */
+    String MAX_WIN = "maxWin";
+
+    /**
+     * Obrót bębnów (S1, S2) albo zrzut planszy (S3).
+     *
+     * @param phase         {@code base} albo {@code free}
+     * @param grid          siatka symboli po zatrzymaniu
+     * @param anticipation  bębny do spowolnienia („prawie bonus”), może być pusta
+     * @param freeSpinIndex numer darmowego spinu od 1 (tylko {@code free})
+     * @param freeSpinsLeft ile darmowych spinów zostało po tym (tylko {@code free})
+     * @param orbs          kule mnożników na planszy (tylko S3; w grze podstawowej pusta lista)
+     */
+    @JsonTypeName("spin")
+    record Spin(String phase, String[][] grid, List<Integer> anticipation, Integer freeSpinIndex,
+                Integer freeSpinsLeft, List<Orb> orbs) implements RoundStep {
+    }
+
+    /** S2: WILD rozszerza się na całe bębny {@code reels}; {@code grid} to siatka po rozszerzeniu. */
+    @JsonTypeName("expandWild")
+    record ExpandWild(List<Integer> reels, String[][] grid) implements RoundStep {
+    }
+
+    /**
+     * Funkcja specjalna: {@code neonJackpot} (S1, cały ekran jednego symbolu: wygrana linii × {@code multiplier},
+     * krok dodaje {@code win} = (mnożnik − 1) × wygrana linii) albo {@code maxWin} (osiągnięty limit wygranej rundy,
+     * {@code multiplier} = limit jako wielokrotność zakładu, bez {@code win}).
+     */
+    @JsonTypeName("feature")
+    record Feature(String name, int multiplier, Long win, Long totalWin) implements RoundStep {
+    }
+
+    /** Ocena wygranych po obrocie albo po kaskadzie. */
+    @JsonTypeName("win")
+    record Win(List<WinItem> wins, long win, long totalWin) implements RoundStep {
+    }
+
+    /**
+     * S3: wygrane symbole pękają ({@code removed}), reszta opada, a od góry dochodzą {@code newSymbols}
+     * (dla każdego bębna lista od góry). {@code grid} to siatka po opadzie, {@code orbs} to nowe kule mnożników
+     * (pozycje po opadzie).
+     */
+    @JsonTypeName("cascade")
+    record Cascade(int[][] removed, List<List<String>> newSymbols, String[][] grid, List<Orb> orbs)
+            implements RoundStep {
+    }
+
+    /**
+     * S3, darmowe spiny: koniec sekwencji kaskad, suma kul {@code orbsSum} mnoży wygraną sekwencji
+     * {@code baseWin}; krok dodaje {@code win} = {@code baseWin} × ({@code orbsSum} − 1).
+     */
+    @JsonTypeName("applyMultiplier")
+    record ApplyMultiplier(int orbsSum, long baseWin, long win, long totalWin) implements RoundStep {
+    }
+
+    /** Aktywacja {@code count} darmowych spinów przez scattery na pozycjach {@code trigger}. */
+    @JsonTypeName("freeSpinsStart")
+    record FreeSpinsStart(int count, int[][] trigger) implements RoundStep {
+    }
+
+    /** Dodatkowe darmowe spiny w trakcie darmowych spinów. */
+    @JsonTypeName("freeSpinsRetrigger")
+    record FreeSpinsRetrigger(int added, int[][] trigger, int freeSpinsLeft) implements RoundStep {
+    }
+
+    /** Koniec darmowych spinów; {@code freeSpinsWin} = suma wygranych z darmowych spinów. */
+    @JsonTypeName("freeSpinsEnd")
+    record FreeSpinsEnd(long freeSpinsWin) implements RoundStep {
+    }
+
+    /** Kula mnożnika S3 na pozycji {@code pos} = {@code [bęben, rząd]} o wartości {@code value} (×2 … ×100). */
+    record Orb(int[] pos, int value) {
+    }
+}

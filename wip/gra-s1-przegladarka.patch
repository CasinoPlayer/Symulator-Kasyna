+  constructor(rate, duration, spawn) {
+    this.rate = rate;
+    this.left = duration ?? Infinity;
+    this.spawn = spawn;
+    this.acc = 0;
+    this.alive = true;
+  }
+
+  stop() {
+    this.alive = false;
+  }

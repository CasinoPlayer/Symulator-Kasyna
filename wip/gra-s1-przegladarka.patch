+const S3_TIMING = Object.freeze({
+  startGap: 30, windupDist: 0, windupMs: 0, accelMs: 120, vmax: 30,
+  stops: [480, 530, 580, 630, 680, 730], brakeMs: 200, overshoot: 0.08, settleMs: 120,
+  anticipationMs: 700, anticipationSlowAfter: 300, anticipationSlowMs: 200, anticipationSpeed: 0.55,
+  matchWindowMs: 300, lateLeadMs: 400, slamGap: 30, slamBrake: 0.6,
+});
+
+/** Kolory i etykiety symboli (01 § 10.4, § 11.4). */
+const STYLE = {
+  'zloty-faraon': {
+    prefix: 's2', bg: ['#050B24', '#1F2A5A', '#3A2A10'], frame: 0xf5c542, timing: S2_TIMING, engine: 'LINES', music: 'mus_s2', loop: 'sfx_beben_petla_s2',
+    symbols: {
+      10: ['#2EC4B6', '10'], j: ['#19D17A', 'J'], q: ['#E2553A', 'Q'], k: ['#1F4FD8', 'K'], a: ['#8F3DFF', 'A'], ankh: ['#F5C542', '☥'],
+      oko: ['#2EC4B6', '◉'], skarabeusz: ['#19D17A', '✦'], anubis: ['#FFB23D', '▲'], faraon: ['#FFE08A', '♛'], wild: ['#FFE08A', 'WILD'], scatter: ['#9FE8FF', '△'],
+    },
+    weights: { 10: 6, j: 6, q: 5, k: 5, a: 5, ankh: 4, oko: 3, skarabeusz: 3, anubis: 2, faraon: 2, wild: 1, scatter: 1 },
+  },
+  'krysztalowa-kaskada': {
+    prefix: 's3', bg: ['#070A1F', '#141A44', '#0A2A2A'], frame: 0x8f3dff, timing: S3_TIMING, engine: 'CLUSTER', music: 'mus_s3', loop: 'sfx_s3_opad',
+    symbols: {
+      szafir: ['#2F6BFF', '◆'], szmaragd: ['#19D17A', '◆'], ametyst: ['#A64DFF', '◆'], topaz: ['#FFB23D', '◆'],
+      rubin: ['#FF2D55', '♥'], diament: ['#E8FBFF', '◇'], cebula: ['#FFE08A', '●'], scatter: ['#5CFFB0', '✶'], mnoznik: ['#FFFFFF', '×'],
+    },
+    weights: { szafir: 6, szmaragd: 6, ametyst: 5, topaz: 5, rubin: 3, diament: 2, cebula: 2, scatter: 1, mnoznik: 1 },
+  },
+};
+
+function drawTile(size, color, label) {
+  const c = makeCanvas(size, size);
+  const x = c.getContext('2d');
+  const r = size * 0.42;
+  x.translate(size / 2, size / 2);
+  x.fillStyle = radial(x, -r * 0.3, -r * 0.4, r * 0.1, r * 1.3, [[0, '#FFFFFF'], [0.25, color], [1, '#05030F']]);
+  x.beginPath();
+  x.roundRect(-r, -r, r * 2, r * 2, r * 0.35);
+  x.fill();
+  x.lineWidth = size * 0.03;
+  x.strokeStyle = linear(x, 0, -r, 0, r, [[0, '#FFF6D6'], [0.5, '#F5C542'], [1, '#5C3A00']]);
+  x.stroke();
+  x.fillStyle = '#FFFFFF';
+  x.shadowColor = color;
+  x.shadowBlur = size * 0.06;
+  x.textAlign = 'center';
+  x.textBaseline = 'middle';
+  x.font = `800 ${Math.round(size * (label.length > 2 ? 0.2 : 0.42))}px Manrope, system-ui, sans-serif`;
+  x.fillText(label, 0, size * 0.02);
+  return c;
+}
+
+export class PlaceholderGame extends BaseGame {
+  constructor(o) {
+    const st = STYLE[o.slot.code] ?? STYLE['zloty-faraon'];
+    super({
+      ...o,
+      config: {
+        code: o.slot.code, reels: o.slot.reels, rows: o.slot.rows, timing: st.timing, engine: st.engine, wildCode: 'wild',
+        music: st.music, reelLoop: st.loop, bgLuma: 0.08, fillerWeights: st.weights, lineColors: [0xffe08a, 0x2ec4b6],
+      },
+    });
+    this.style = st;
+  }
+
+  imageRequests() {
+    return Object.keys(this.style.symbols).flatMap((code) => {
+      const id = `${this.style.prefix}_sym_${code}`;
+      return [{ id }, { id, variant: 'ruch1' }, { id, variant: 'ruch2' }, { id, variant: 'glow' }, { id, variant: 'syl' }];
+    });
+  }
+
+  async buildViews() {
+    const { PIXI } = this;
+    for (const [code, [color, label]] of Object.entries(this.style.symbols)) {
+      const id = `${this.style.prefix}_sym_${code}`;
+      const main = this.resources.texture(id);
+      if (main) {
+        this.views.set(code, { main, blur1: this.resources.texture(id, 'ruch1'), blur2: this.resources.texture(id, 'ruch2'), glow: this.resources.texture(id, 'glow'), syl: this.resources.texture(id, 'syl'), scale: 1 });
+        continue;
+      }
+      const c = drawTile(192, color, label);
+      const glow = softShape(c, { pad: 0.15, blur: 0.07 });
+      this.views.set(code, {
+        main: canvasTexture(PIXI, c), blur1: canvasTexture(PIXI, motionBlur(c, 0.08)), blur2: canvasTexture(PIXI, motionBlur(c, 0.14, 1.04)),
+        syl: canvasTexture(PIXI, silhouette(c)), glow: canvasTexture(PIXI, glow), scale: 0.96, glowScale: glow.width / c.width,
+      });
+    }
+  }
+
+  buildScene() {
+    const { PIXI } = this;
+    const L = this.gameApp.layers;
+    this.bg = new PIXI.Sprite(PIXI.Texture.WHITE);
+    this.bg.tint = 0x07060f;
+    L.bg.addChild(this.bg);
+    this.glowBg = new PIXI.Sprite(this.tex.radial);
+    this.glowBg.anchor.set(0.5);
+    this.glowBg.tint = this.style.frame;
+    this.glowBg.alpha = 0.25;
+    L.bg.addChild(this.glowBg);
+    this.under = new PIXI.Graphics();
+    L.under.addChild(this.under);
+    this.frameG = new PIXI.Graphics();
+    L.frame.addChild(this.frameG);
+    this.title = new PIXI.Text({ text: this.slot.name, style: { fontFamily: 'Cinzel, Georgia, serif', fontWeight: '900', fontSize: 40, fill: '#FFE08A', stroke: { color: '#3D2700', width: 5 } } });
+    this.title.anchor.set(0.5, 1);
+    L.logo.addChild(this.title);
+  }
+
+  layoutScene(lay) {
+    const { w, h } = lay;
+    const R = this.config.reels;
+    const rows = this.config.rows;
+    const top = Math.max(40, h * 0.1);
+    const S = Math.floor(Math.min((w * 0.92) / (R + 0.4), (h - top - h * 0.06) / (rows + 0.4)));
+    const gap = S * 0.04;
+    const winW = R * S + (R - 1) * gap;
+    const winH = rows * S;
+    const x = (w - winW) / 2;
+    const y = top + (h - top - winH) / 2;
+    this.bg.width = w;
+    this.bg.height = h;
+    this.glowBg.position.set(w / 2, h / 2);
+    this.glowBg.width = w * 1.4;
+    this.glowBg.height = h * 1.2;
+    this.under.clear().roundRect(x - S * 0.1, y - S * 0.1, winW + S * 0.2, winH + S * 0.2, S * 0.12).fill({ color: 0x0a0820, alpha: 0.92 });
+    this.frameG.clear()
+      .roundRect(x - S * 0.12, y - S * 0.12, winW + S * 0.24, winH + S * 0.24, S * 0.14)
+      .stroke({ width: Math.max(3, S * 0.05), color: this.style.frame, alpha: 0.95 })
+      .roundRect(x - S * 0.2, y - S * 0.2, winW + S * 0.4, winH + S * 0.4, S * 0.18)
+      .stroke({ width: Math.max(2, S * 0.02), color: 0xf5c542, alpha: 0.5 });
+    this.title.position.set(w / 2, y - S * 0.25);
+    this.title.style.fontSize = Math.max(20, S * 0.32);
+    return { x, y, cell: S, gap };
+  }
+}
diff --git a/src/main/resources/static/js/game/reels/paylines.js b/src/main/resources/static/js/game/reels/paylines.js
new file mode 100644
index 0000000..a2c2bc9
--- /dev/null
+++ b/src/main/resources/static/js/game/reels/paylines.js
@@ -0,0 +1,184 @@
+/**
+ * game/reels/paylines.js — linie wygranych (04 § 2.16).
+ *
+ * Linia = wstęga `MeshRope` rozpięta na środkach pól (przedłużona o 0,35 pola poza skrajne bębny) z miękką teksturą
+ * (przezroczysty → biały → przezroczysty w poprzek). Dlaczego nie `Graphics`: renderujemy bez MSAA, więc linie
+ * z Graphics miałyby poszarpane krawędzie; miękka tekstura daje gładki brzeg za darmo.
+ * Dwie wstęgi na linię: poświata 22 px (alfa 0,35, linie nieparzyste magenta, parzyste cyjan — S1) i rdzeń 6 px.
+ * Rysowanie: koniec wstęgi wędruje od lewej do prawej w 220 ms (easeOutCubic) — punkty „przed głową” leżą na głowie.
+ * Kształt linii pochodzi z `paylines` z GET /api/slots/{code} (rząd dla kolejnych bębnów, 0 = górny).
+ */
+
+import { easeOutCubic } from '../core/easing.js';
+
+const POINTS = 36;
+
+class Line {
+  constructor(PIXI, layer, { core, glow }, coreW, glowW) {
+    this.points = Array.from({ length: POINTS }, () => new PIXI.Point());
+    this.glowPoints = Array.from({ length: POINTS }, () => new PIXI.Point());
+    this.glow = new PIXI.MeshRope({ texture: glow, points: this.glowPoints, textureScale: 0, width: glowW });
+    this.core = new PIXI.MeshRope({ texture: core, points: this.points, textureScale: 0, width: coreW });
+    // MeshRope w Pixi 8 co klatkę przywraca grubość = wysokość tekstury; geometrię aktualizujemy sami
+    for (const [rope, w] of [[this.glow, glowW], [this.core, coreW]]) {
+      rope.autoUpdate = false;
+      rope.onRender = null;
+      rope.geometry._width = w;
+    }
+    this.glow.blendMode = 'add';
+    this.core.blendMode = 'add';
+    this.root = new PIXI.Container();
+    this.root.addChild(this.glow, this.core);
+    layer.addChild(this.root);
+    this.path = [];
+  }
+
+  setWidths(coreW, glowW) {
+    this.core.geometry._width = coreW;
+    this.glow.geometry._width = glowW;
+  }
+
+  /** Ścieżka: lista punktów łamanej (środki pól + przedłużenia). Próbkujemy ją równomiernie po długości. */
+  setPath(path) {
+    this.path = path;
+    const seg = [];
+    let total = 0;
+    for (let i = 1; i < path.length; i++) {
+      const l = Math.hypot(path[i].x - path[i - 1].x, path[i].y - path[i - 1].y);
+      seg.push(l);
+      total += l;
+    }
+    this.samples = [];
+    for (let k = 0; k < POINTS; k++) {
+      let d = (k / (POINTS - 1)) * total;
+      let i = 0;
+      while (i < seg.length - 1 && d > seg[i]) d -= seg[i++];
+      const t = seg[i] ? d / seg[i] : 0;
+      this.samples.push({ x: path[i].x + (path[i + 1].x - path[i].x) * t, y: path[i].y + (path[i + 1].y - path[i].y) * t });
+    }
+  }
+
+  /** Odsłania linię do ułamka `u` długości (0…1). */
+  reveal(u) {
+    const head = Math.max(1, Math.round(u * (POINTS - 1)));
+    for (let k = 0; k < POINTS; k++) {
+      const s = this.samples[Math.min(k, head)];
+      this.points[k].set(s.x, s.y);
+      this.glowPoints[k].set(s.x, s.y);
+    }
+    this.core.geometry.update();
+    this.glow.geometry.update();
+  }
+}
+
+export class WinLines {
+  #lines = [];
+  #active = [];
+
+  /**
+   * @param {import('../core/app.js').GameApp} gameApp
+   * @param {import('pixi.js').Container} layer warstwa L6 (`lines`, mieszanie add)
+   * @param {{core: Texture, glow: Texture}} textures
+   * @param {import('./reelset.js').ReelSet} reels
+   * @param {number[][]} paylines z API (indeks linii + 1 = numer linii w wygranych)
+   */
+  constructor(gameApp, layer, textures, reels, paylines, { colors = [0xff2e88, 0x21e6ff], coreColor = 0xffffff } = {}) {
+    this.gameApp = gameApp;
+    this.layer = layer;
+    this.textures = textures;
+    this.reels = reels;
+    this.paylines = paylines ?? [];
+    this.colors = colors;
+    this.coreColor = coreColor;
+  }
+
+  #widths() {
+    const S = this.reels.cell;
+    return [Math.max(3, S * 0.035), Math.max(10, S * 0.13)];
+  }
+
+  #get() {
+    const [cw, gw] = this.#widths();
+    const line = this.#lines.pop() ?? new Line(this.gameApp.PIXI, this.layer, this.textures, cw, gw);
+    line.setWidths(cw, gw);
+    line.root.visible = true;
+    line.root.alpha = 1;
+    this.layer.addChild(line.root);
+    return line;
+  }
+
+  /** Ścieżka linii o numerze `n` (od 1): środki pól + 0,35 pola przedłużenia na końcach. */
+  pathFor(n) {
+    const rows = this.paylines[n - 1];
+    if (!rows) return null;
+    const pts = rows.map((row, reel) => this.reels.cellCenter(reel, row));
+    const ext = this.reels.cell * 0.35;
+    const a = pts[0];
+    const b = pts[1] ?? { x: a.x + 1, y: a.y };
+    const z = pts.at(-1);
+    const y = pts.at(-2) ?? { x: z.x - 1, y: z.y };
+    const dir = (p, q) => {
+      const l = Math.hypot(q.x - p.x, q.y - p.y) || 1;
+      return { x: (q.x - p.x) / l, y: (q.y - p.y) / l };
+    };
+    const d0 = dir(b, a);
+    const d1 = dir(y, z);
+    return [{ x: a.x + d0.x * ext, y: a.y + d0.y * ext }, ...pts, { x: z.x + d1.x * ext, y: z.y + d1.y * ext }];
+  }
+
+  /** Środek linii (miejsce na kwotę linii). */
+  centerOf(n) {
+    const rows = this.paylines[n - 1];
+    if (!rows) return null;
+    const mid = Math.floor(rows.length / 2);
+    return this.reels.cellCenter(mid, rows[mid]);
+  }
+
+  /**
+   * Rysuje linię `n` (220 ms × tempo). Zwraca obiekt linii.
+   * @param {{tempo?: number, glowAlpha?: number}} o
+   */
+  draw(n, { tempo = 1, glowAlpha = 0.35, drawMs = 220 } = {}) {
+    const path = this.pathFor(n);
+    if (!path) return null;
+    const line = this.#get();
+    line.number = n;
+    line.setPath(path);
+    line.glow.tint = this.colors[(n - 1) % this.colors.length];
+    line.core.tint = this.coreColor;
+    line.glow.alpha = glowAlpha;
+    line.reveal(0);
+    this.#active.push(line);
+    const reduced = this.gameApp.motion.reduced;
+    this.gameApp.tweener.tween(reduced ? 1 : drawMs * tempo, (e) => line.reveal(e), { ease: easeOutCubic });
+    return line;
+  }
+
+  /** Faza (b) cyklu: jedna linia wyraźnie, pozostałe przygaszone do 0,25 (null = wszystkie wyraźnie). */
+  focus(n) {
+    for (const l of this.#active) {
+      const target = n === null || l.number === n ? 1 : 0.25;
+      this.gameApp.tweener.to(l.root, { alpha: target }, { duration: 160 });
+    }
+  }
+
+  /** Gaszenie wszystkich linii (E24: 120 ms). */
+  clear(ms = 120) {
+    const lines = this.#active;
+    this.#active = [];
+    for (const l of lines) {
+      this.gameApp.tweener.killTweensOf(l.root);
+      this.gameApp.tweener.to(l.root, { alpha: 0 }, {
+        duration: ms,
+        onComplete: () => {
+          l.root.visible = false;
+          this.#lines.push(l);
+        },
+      });
+    }
+  }
+
+  get count() {
+    return this.#active.length;
+  }
+}
diff --git a/src/main/resources/static/js/game/reels/reelset.js b/src/main/resources/static/js/game/reels/reelset.js
new file mode 100644
index 0000000..a902157
--- /dev/null
+++ b/src/main/resources/static/js/game/reels/reelset.js
@@ -0,0 +1,498 @@
+/**
+ * game/reels/reelset.js — silnik bębnów (S1, S2): fizyka z 04 § 2.14.
+ *
+ * Model taśmy: bęben to nieskończona pionowa taśma symboli. Przesunięcie `p` (w polach) rośnie, gdy taśma jedzie
+ * w dół. Symbol o indeksie `i` stoi na wysokości `(i + p)` pól od górnej krawędzi okna, więc rząd `j` pokazuje
+ * indeks `j − p`. Symbol pod indeksem bierzemy z mapy wyniku (ustawionej, gdy przyjdzie odpowiedź serwera) albo —
+ * dla pozostałych pozycji — z wizualnej taśmy wybieranej stałym skrótem z indeksu (ta sama pozycja = ten sam
+ * symbol, więc nic nie migocze). Na bęben przypada `wiersze + 2` sprite'ów, przypisywanych co klatkę do widocznych
+ * indeksów.
+ *
+ * Fazy (oś czasu od kliknięcia SPIN, czasy × tempo; TURBO = 0,45):
+ *   ZAMACH      0,18 pola w górę w 120 ms (easeOutQuad)              — w RM pomijany
+ *   ROZPĘDZANIE do v_max w 200 ms, prędkość rośnie jak easeInQuad
+ *   OBRÓT       v_max = 22 pola/s (S1)
+ *   DOPASOWANIE gdy wynik jest znany: prędkość korygowana współczynnikiem f (|f−1| ≈ kilka %), żeby koniec hamowania
+ *               wypadł DOKŁADNIE na pozycji całkowitej N + overshoot w zaplanowanej milisekundzie stopu
+ *   HAMOWANIE   p(t) = pb + d·(1 − (1 − t/D)³) — prędkość na starcie 3d/D = v (brak szarpnięcia), koniec z v = 0
+ *               ZA celem o overshoot 0,12 pola; ta chwila to „moment stopu” (dźwięk, lądowanie, haptyka)
+ *   OSIADANIE   powrót o overshoot w 160 ms, easeOutBack(1,2) (odbicie 5,3% ≈ 1 px)  — w RM bez overshootu
+ * Antycypacja: wskazane bębny stają później (+900 ms w S1), po 400 ms zwalniają do 0,55 v_max (300 ms, easeInOutSine).
+ * Szybki stop: wszystkie kręcące się bębny hamują od razu w 0,6 D, co 40 ms; antycypacja pominięta.
+ * Rozmycie ruchu = podmiana tekstur (ruch2 > 60% v_max, ruch1 20–60%, ostry < 20%) — zero kosztu GPU.
+ */
+
+import { easeOutQuad, easeInQuad, easeInOutSine, easeOutBack } from '../core/easing.js';
+import { hashInt } from '../core/random.js';
+
+const settleEase = easeOutBack(1.2);
+
+export const S1_TIMING = Object.freeze({
+  startGap: 50, windupDist: 0.18, windupMs: 120, accelMs: 200, vmax: 22,
+  stops: [1240, 1420, 1600], brakeMs: 260, overshoot: 0.12, settleMs: 160,
+  anticipationMs: 900, anticipationSlowAfter: 400, anticipationSlowMs: 300, anticipationSpeed: 0.55,
+  matchWindowMs: 600, lateLeadMs: 450, slamGap: 40, slamBrake: 0.6,
+});
+
+/**
+ * Jeden widoczny symbol (slot):
+ *   root  — środek pola (pozycja na taśmie; puls wygranej skaluje wokół środka),
+ *   body  — dolna krawędź pola (squash & stretch przy lądowaniu skaluje wokół dna — symbol „siada”, 04 § 2.13),
+ *   main  — sprite symbolu wyśrodkowany w polu, shadow — cień rzucany (przesunięty o +3% / +5% pola, alfa 0,45).
+ */
+class Slot {
+  constructor(PIXI) {
+    this.root = new PIXI.Container();
+    this.body = new PIXI.Container();
+    this.shadow = new PIXI.Sprite();
+    this.main = new PIXI.Sprite();
+    this.shadow.anchor.set(0.5);
+    this.main.anchor.set(0.5);
+    this.shadow.alpha = 0.45;
+    this.body.addChild(this.shadow, this.main);
+    this.root.addChild(this.body);
+    this.code = null;
+    this.index = 0;
+    this.texKind = '';
+  }
+}
+
+class Reel {
+  constructor(set, index) {
+    const { PIXI } = set.gameApp;
+    this.set = set;
+    this.index = index;
+    this.container = new PIXI.Container({ label: `beben${index}` });
+    this.slots = Array.from({ length: set.rows + 2 }, () => new Slot(PIXI));
+    for (const s of this.slots) this.container.addChild(s.root);
+    this.p = 0;
+    this.v = 0;
+    this.state = 'idle';
+    this.map = new Map();
+    this.lifted = new Set();
+  }
+
+  /** Kod symbolu pod indeksem taśmy (wynik z mapy albo wizualna taśma). */
+  codeAt(i) {
+    const c = this.map.get(i);
+    if (c !== undefined) return c;
+    return this.set.filler(hashInt(i, this.index * 7919 + 17));
+  }
+}
+
+export class ReelSet extends EventTarget {
+  /**
+   * @param {import('../core/app.js').GameApp} gameApp
+   * @param {{reels: number, rows: number, views: {get(code: string): object}, filler: (r: number) => string, timing?: object}} o
+   */
+  constructor(gameApp, { reels, rows, views, filler, timing = S1_TIMING }) {
+    super();
+    const { PIXI } = gameApp;
+    this.gameApp = gameApp;
+    this.rows = rows;
+    this.views = views;
+    this.filler = filler;
+    this.timing = timing;
+    this.root = new PIXI.Container({ label: 'bebny' });
+    this.mask = new PIXI.Graphics();
+    this.root.addChild(this.mask);
+    this.root.mask = this.mask;
+    this.reels = Array.from({ length: reels }, (_, i) => new Reel(this, i));
+    for (const r of this.reels) this.root.addChild(r.container);
+    this.time = 0;
+    this.cell = 100;
+    this.gap = 0;
+    this.origin = { x: 0, y: 0 };
+    this.spinning = false;
+    this.grid = Array.from({ length: reels }, () => Array.from({ length: rows }, () => filler(Math.random())));
+    this.#resolveLand = null;
+    this.handlers = {};
+  }
+
+  #resolveLand;
+
+  /** Ustawia geometrię: lewy górny róg okna, rozmiar pola, odstęp między bębnami. */
+  layout(x, y, cell, gap = 0) {
+    this.origin = { x, y };
+    this.cell = cell;
+    this.gap = gap;
+    const w = this.reels.length * cell + (this.reels.length - 1) * gap;
+    const h = this.rows * cell;
+    this.mask.clear().rect(x - gap / 2, y, w + gap, h).fill(0xffffff);
+    this.reels.forEach((r, i) => {
+      r.container.position.set(x + i * (cell + gap), y);
+      for (const s of r.slots) this.#styleSlot(s);
+    });
+    this.#render(true);
+  }
+
+  get windowRect() {
+    const w = this.reels.length * this.cell + (this.reels.length - 1) * this.gap;
+    return { x: this.origin.x, y: this.origin.y, w, h: this.rows * this.cell };
+  }
+
+  /** Środek pola (bęben, rząd) we współrzędnych warstwy. */
+  cellCenter(reel, row) {
+    return {
+      x: this.origin.x + reel * (this.cell + this.gap) + this.cell / 2,
+      y: this.origin.y + row * this.cell + this.cell / 2,
+    };
+  }
+
+  /** Natychmiastowe ustawienie planszy (plansza startowa, wynik po błędzie, kaskady zastępcze). */
+  setGrid(grid) {
+    this.grid = grid.map((col) => [...col]);
+    for (const r of this.reels) {
+      const N = Math.round(r.p);
+      r.p = N;
+      r.map.clear();
+      for (let j = 0; j < this.rows; j++) r.map.set(j - N, grid[r.index][j]);
+    }
+    this.#render(true);
+  }
+
+  /** Slot pokazujący pole (bęben, rząd), gdy bębny stoją. */
+  cell(reel, row) {
+    const r = this.reels[reel];
+    const idx = row - Math.round(r.p);
+    return r.slots.find((s) => s.index === idx) ?? null;
+  }
+
+  // ------------------------------------------------------------------------------------------- start i lądowanie
+
+  /** E24: start obrotu w tej samej klatce co kliknięcie — nie czekamy na serwer. */
+  startSpin({ tempo = 1 } = {}) {
+    const T = this.timing;
+    const reduced = this.gameApp.motion.reduced;
+    this.dropAll();
+    this.spinning = true;
+    this.tempo = tempo;
+    this.time = 0;
+    this.result = null;
+    this.slammed = false;
+    this.aborted = false;
+    this.reels.forEach((r, i) => {
+      const t0 = i * T.startGap * tempo;
+      r.plan = {
+        t0,
+        windEnd: t0 + (reduced ? 0 : T.windupMs * tempo),
+        accelEnd: t0 + (reduced ? 0 : T.windupMs * tempo) + T.accelMs * tempo,
+        stopAt: T.stops[Math.min(i, T.stops.length - 1)] * tempo + Math.max(0, i - T.stops.length + 1) * (T.stops.at(-1) - T.stops.at(-2)) * tempo,
+        brakeMs: T.brakeMs * tempo,
+        settleMs: reduced ? 0 : T.settleMs * tempo,
+        overshoot: reduced ? 0 : T.overshoot,
+        antStart: null,
+      };
+      r.p0 = Math.round(r.p);
+      r.state = 'windup';
+      r.v = 0;
+      r.matched = false;
+      r.approachSent = false;
+      r.stopSent = false;
+    });
+    this.dispatchEvent(new CustomEvent('spinstart'));
+  }
+
+  /**
+   * Wynik z serwera: bębny dopasowują się i stają na `grid`. Zwraca obietnicę końca osiadania ostatniego bębna.
+   * @param {string[][]} grid grid[bęben][rząd]
+   * @param {{anticipation?: number[]}} o lista bębnów do spowolnienia (krok `spin` z 09 § 2.4)
+   */
+  land(grid, { anticipation = [] } = {}) {
+    if (!this.spinning) this.startSpin({ tempo: this.tempo ?? 1 });
+    const T = this.timing;
+    const tempo = this.tempo;
+    this.result = grid.map((c) => [...c]);
+    // antycypacja: każdy wskazany bęben i wszystkie po nim stają później (+900 ms × tempo w S1)
+    const ant = this.slammed ? [] : [...anticipation].sort((a, b) => a - b);
+    this.anticipation = new Set(ant);
+    for (const a of ant) {
+      for (const r of this.reels) if (r.index >= a) r.plan.stopAt += T.anticipationMs * tempo;
+    }
+    for (const a of ant) {
+      const r = this.reels[a];
+      const prev = this.reels[a - 1];
+      r.plan.antStart = prev ? prev.plan.stopAt : 0;
+    }
+    // spóźniona odpowiedź (04 § 2.14): pierwszy stop = max(plan, teraz + 450 ms), kolejne przesuwamy o tyle samo
+    const first = this.reels[0].plan;
+    const minFirst = this.time + T.lateLeadMs * tempo;
+    if (!this.slammed && first.stopAt < minFirst) {
+      const shift = minFirst - first.stopAt;
+      for (const r of this.reels) {
+        r.plan.stopAt += shift;
+        if (r.plan.antStart !== null) r.plan.antStart += shift;
+      }
+    }
+    if (this.slammed) this.#applySlam();
+    return new Promise((resolve) => { this.#resolveLand = resolve; });
+  }
+
+  /** Szybki stop (przycisk STOP / Spacja / dotknięcie bębnów). Bez wyniku — wykona się po jego nadejściu. */
+  slam() {
+    if (!this.spinning || this.slammed) return;
+    this.slammed = true;
+    if (this.result) this.#applySlam();
+  }
+
+  #applySlam() {
+    const T = this.timing;
+    let k = 0;
+    for (const r of this.reels) {
+      if (r.state === 'brake' || r.state === 'settle' || r.state === 'idle') continue;
+      const brakeMs = T.brakeMs * T.slamBrake * this.tempo;
+      const start = Math.max(this.time, r.plan.accelEnd) + k * T.slamGap;
+      r.plan.stopAt = start + brakeMs;
+      r.plan.brakeMs = brakeMs;
+      r.plan.antStart = null;
+      r.matched = false;            // ponowne dopasowanie do nowej chwili stopu
+      r.slamFast = true;
+      k++;
+    }
+    this.anticipation = new Set();
+  }
+
+  /** E40: łagodne hamowanie (1,5 D, bez overshootu) na planszy sprzed spinu — wyniku nie znamy, nie wymyślamy go. */
+  abort() {
+    if (!this.spinning) return Promise.resolve();
+    this.aborted = true;
+    const prev = this.grid;
+    const p = this.land(prev, {});
+    const T = this.timing;
+    let k = 0;
+    for (const r of this.reels) {
+      if (r.state === 'brake' || r.state === 'settle' || r.state === 'idle') continue;
+      const brakeMs = T.brakeMs * 1.5;
+      r.plan.stopAt = Math.max(this.time, r.plan.accelEnd) + k * 60 + brakeMs;
+      r.plan.brakeMs = brakeMs;
+      r.plan.overshoot = 0;
+      r.plan.settleMs = 0;
+      r.plan.antStart = null;
+      r.matched = false;
+      k++;
+    }
+    return p;
+  }
+
+  // ------------------------------------------------------------------------------------------- symulacja
+
+  /** Prędkość nominalna (bez korekty dopasowania) w chwili t — do całkowania drogi przy dopasowaniu. */
+  #vNominal(r, t) {
+    const T = this.timing;
+    const { plan } = r;
+    if (t < plan.windEnd) return 0;
+    if (t < plan.accelEnd) return T.vmax * easeInQuad((t - plan.windEnd) / (plan.accelEnd - plan.windEnd || 1));
+    if (plan.antStart !== null) {
+      const a0 = plan.antStart + T.anticipationSlowAfter * this.tempo;
+      const a1 = a0 + T.anticipationSlowMs * this.tempo;
+      if (t >= a1) return T.vmax * T.anticipationSpeed;
+      if (t >= a0) return T.vmax * (1 - (1 - T.anticipationSpeed) * easeInOutSine((t - a0) / (a1 - a0)));
+    }
+    return T.vmax;
+  }
+
+  /**
+   * Dopasowanie: wybiera pozycję docelową N (całkowitą) i współczynnik prędkości f tak, by
+   * p(teraz) + f·(droga nominalna do hamowania) + f·v_hamowania·D/3 = N + overshoot.
+   */
+  #match(r) {
+    const { plan } = r;
+    const t0 = this.time;
+    const tb = plan.stopAt - plan.brakeMs;
+    const steps = 48;
+    let dist = 0;
+    if (tb > t0) {
+      const h = (tb - t0) / steps;
+      for (let s = 0; s < steps; s++) dist += this.#vNominal(r, t0 + (s + 0.5) * h) * (h / 1000);
+    }
+    const vb = this.#vNominal(r, Math.max(t0, tb));
+    const brakeDist = (vb * plan.brakeMs) / 1000 / 3;
+    const natural = r.p + dist + brakeDist - plan.overshoot;
+    // wynik musi wjechać z góry, gdy nie jest jeszcze widoczny: N > p + wiersze + 1 (przy szybkim stopie — podmiana
+    // w rozmyciu ruchu, niezauważalna)
+    const N = Math.max(Math.round(natural), r.slamFast || this.aborted ? Math.ceil(natural) : Math.ceil(r.p + this.rows + 1));
+    const denom = dist + brakeDist;
+    r.f = denom > 0.01 ? (N + plan.overshoot - r.p) / denom : 1;
+    r.N = N;
+    r.map.clear();
+    const col = this.result[r.index];
+    for (let j = 0; j < this.rows; j++) r.map.set(j - N, col[j]);
+    r.matched = true;
+  }
+
+  update(dt) {
+    if (!this.spinning) return;
+    this.time += dt;
+    const T = this.timing;
+    const t = this.time;
+    let allIdle = true;
+    for (const r of this.reels) {
+      const { plan } = r;
+      if (r.state === 'idle') continue;
+      allIdle = false;
+      if (r.state === 'windup') {
+        if (t < plan.t0) continue;
+        if (t < plan.windEnd) {
+          r.p = r.p0 - T.windupDist * easeOutQuad((t - plan.t0) / (plan.windEnd - plan.t0));
+          r.v = 0;
+          continue;
+        }
+        r.state = 'spin';
+      }
+      if (r.state === 'spin') {
+        const tb = plan.stopAt - plan.brakeMs;
+        if (this.result && !r.matched && t >= plan.accelEnd - 1) this.#match(r);
+        if (!(this.result && r.matched && t >= tb)) {
+          // całkowanie prędkości (metoda punktu środkowego — dokładna dla stałej prędkości)
+          const v = this.#vNominal(r, t - dt / 2) * (r.matched ? r.f : 1);
+          r.v = v;
+          r.p += (v * dt) / 1000;
+          if (r.plan.antStart !== null && !r.antSent && t >= r.plan.antStart) {
+            r.antSent = true;
+            this.#emit('anticipation', { reel: r.index, until: plan.stopAt });
+          }
+          continue;
+        }
+        // start hamowania: droga d liczona z RZECZYWISTEJ pozycji — wyrównanie zawsze dokładne
+        r.state = 'brake';
+        r.pb = r.p;
+        r.d = r.N + plan.overshoot - r.p;
+        r.tb = tb;
+      }
+      if (r.state === 'brake') {
+        const D = plan.brakeMs;
+        const u = Math.min(1, (t - r.tb) / D);
+        r.p = r.pb + r.d * (1 - (1 - u) ** 3);
+        r.v = ((3 * r.d) / (D / 1000)) * (1 - u) ** 2;
+        const left = plan.stopAt - t;
+        if (!r.approachSent && left <= 170) {
+          r.approachSent = true;
+          // zapowiedź stopu z dokładnym czasem — dźwięk planujemy na zegarze audio (R6), WILD startuje 150 ms wcześniej
+          this.#emit('approach', { reel: r.index, inMs: Math.max(0, left), quick: Boolean(r.slamFast), codes: this.result[r.index] });
+        }
+        if (u >= 1) {
+          r.state = plan.settleMs > 0 ? 'settle' : 'idle';
+          r.ts = t;
+          r.v = 0;
+          if (r.state === 'idle') r.p = r.N;
+          this.#emit('stop', { reel: r.index, quick: Boolean(r.slamFast), codes: this.result[r.index], last: r.index === this.reels.length - 1 });
+        }
+      } else if (r.state === 'settle') {
+        const u = Math.min(1, (t - r.ts) / plan.settleMs);
+        r.p = r.N + plan.overshoot * (1 - settleEase(u));
+        if (u >= 1) {
+          r.p = r.N;
+          r.state = 'idle';
+        }
+      }
+    }
+    this.#render(false);
+    if (allIdle && this.result) this.#finish();
+  }
+
+  #finish() {
+    this.spinning = false;
+    this.grid = this.result.map((c) => [...c]);
+    for (const r of this.reels) {
+      r.slamFast = false;
+      r.antSent = false;
+      r.f = 1;
+    }
+    const resolve = this.#resolveLand;
+    this.#resolveLand = null;
+    this.dispatchEvent(new CustomEvent('settled'));
+    resolve?.();
+  }
+
+  #emit(type, detail) {
+    this.dispatchEvent(new CustomEvent(type, { detail }));
+  }
+
+  /** Przypisuje sprite'y do widocznych indeksów taśmy i dobiera tekstury według prędkości. */
+  #render(force) {
+    const S = this.cell;
+    const vmax = this.timing.vmax;
+    for (const r of this.reels) {
+      const i0 = Math.floor(-r.p) - 1;
+      const speed = Math.abs(r.v) / vmax;
+      const kind = speed > 0.6 ? 'blur2' : speed > 0.2 ? 'blur1' : 'main';
+      for (let k = 0; k < r.slots.length; k++) {
+        const s = r.slots[k];
+        if (r.lifted.has(s)) continue;
+        const idx = i0 + k;
+        const code = r.codeAt(idx);
+        s.index = idx;
+        s.root.y = (idx + r.p) * S + S / 2;
+        s.root.x = S / 2;
+        if (force || s.code !== code || s.texKind !== kind) {
+          s.code = code;
+          s.texKind = kind;
+          this.#styleSlot(s);
+        }
+      }
+    }
+  }
+
+  #styleSlot(s) {
+    if (!s.code) return;
+    const view = this.views.get(s.code);
+    if (!view) return;
+    const S = this.cell;
+    const size = S * (view.scale ?? 0.9);
+    const tex = (s.texKind === 'blur2' && view.blur2) || (s.texKind !== 'main' && view.blur1) || view.main;
+    s.main.texture = tex;
+    // jedna skala według SZEROKOŚCI: tekstury rozmycia są wyższe (smuga w pionie), ale tak samo szerokie
+    s.main.scale.set(size / tex.width);
+    s.body.y = S / 2;
+    s.main.y = -S / 2;
+    const showShadow = Boolean(view.shadow) && s.texKind === 'main';
+    s.shadow.visible = showShadow;
+    if (showShadow) {
+      s.shadow.texture = view.shadow;
+      s.shadow.scale.set((size * (view.shadowScale ?? 1)) / view.shadow.width);
+      s.shadow.position.set(S * 0.03, -S / 2 + S * 0.05);
+      s.shadow.tint = view.shadowTint ?? 0xffffff;
+    }
+  }
+
+  // ------------------------------------------------------------------------------------------- warstwa wygranych
+
+  /** Przenosi slot pola na inną warstwę (np. L5 nad przyciemnieniem), zachowując położenie na ekranie. */
+  lift(reel, row, layer) {
+    const r = this.reels[reel];
+    const slot = this.cell(reel, row);
+    if (!slot || r.lifted.has(slot)) return slot;
+    r.lifted.add(slot);
+    const gx = r.container.x + slot.root.x;
+    const gy = r.container.y + slot.root.y;
+    layer.addChild(slot.root);
+    slot.root.position.set(gx, gy);
+    slot.reel = r;
+    return slot;
+  }
+
+  /** Oddaje wszystkie przeniesione sloty z powrotem do bębnów (przed kolejnym spinem). */
+  dropAll() {
+    for (const r of this.reels) {
+      for (const s of r.lifted) {
+        r.container.addChild(s.root);
+        s.root.scale.set(1);
+        s.root.rotation = 0;
+        s.root.alpha = 1;
+        s.body.scale.set(1);
+        s.body.rotation = 0;
+      }
+      r.lifted.clear();
+    }
+    this.#render(true);
+  }
+
+  /** Wszystkie sloty bębna (np. do animacji lądowania po stopie). */
+  visibleSlots(reel) {
+    const r = this.reels[reel];
+    return r.slots.filter((s) => {
+      const row = s.index + Math.round(r.p);
+      return row >= 0 && row < this.rows;
+    });
+  }
+}
diff --git a/src/main/resources/static/js/game/step-player.js b/src/main/resources/static/js/game/step-player.js
new file mode 100644
index 0000000..2a0fa28
--- /dev/null
+++ b/src/main/resources/static/js/game/step-player.js
@@ -0,0 +1,103 @@
+/**
+ * game/step-player.js — odtwarzacz kroków rundy (kontrakt 09 § 2.4).
+ *
+ * Serwer liczy całą rundę naraz i zwraca listę kroków (`spin`, `win`, `feature`, `cascade`, `expandWild`,
+ * `applyMultiplier`, `freeSpinsStart`, `freeSpinsRetrigger`, `freeSpinsEnd`). Front niczego nie losuje i niczego
+ * nie liczy — StepPlayer odgrywa kroki PO KOLEI: każdy handler jest funkcją `async`, a następny krok startuje,
+ * gdy poprzedni się skończy (`await`). Dzięki temu kolejność animacji = kolejność w odpowiedzi serwera.
+ *
+ * Rozszerzalność: gra rejestruje handlery dla typów, które rozumie (S1: spin, win, feature). Dla pozostałych
+ * typów są handlery DOMYŚLNE (podmiana planszy, komunikat na banerze, licznik darmowych spinów), więc odpowiedź
+ * S2/S3 odegra się poprawnie także w grze, która jeszcze nie ma własnych efektów — S2 i S3 dopiszą swoje handlery
+ * (`player.register('cascade', …)`) bez zmian w runtime.
+ *
+ * Kontekst rundy (`ctx`) przekazywany do handlerów:
+ *   response, steps, index (bieżący krok), bet, tempo (TURBO), autoplay, skip (SkipToken), state (dowolne dane
+ *   gry między krokami), shownWin (suma pokazana na liczniku), next(type) (podgląd kolejnych kroków).
+ */
+
+import { SkipToken } from './core/tween.js';
+import { fxRng } from './core/random.js';
+
+export const STEP_TYPES = Object.freeze([
+  'spin', 'win', 'feature', 'cascade', 'expandWild', 'applyMultiplier', 'freeSpinsStart', 'freeSpinsRetrigger', 'freeSpinsEnd',
+]);
+
+export class StepPlayer extends EventTarget {
+  #handlers = new Map();
+  #hooks = {};
+  playing = false;
+  ctx = null;
+
+  /**
+   * @param {{handlers?: Record<string, Function>, hooks?: {beforeRound?: Function, afterRound?: Function, beforeStep?: Function, afterStep?: Function}}} o
+   */
+  constructor({ handlers = {}, hooks = {} } = {}) {
+    super();
+    for (const [type, fn] of Object.entries(handlers)) this.register(type, fn);
+    this.#hooks = hooks;
+  }
+
+  /** Rejestruje (albo podmienia) handler typu kroku: `async (step, ctx) => {}`. */
+  register(type, fn) {
+    this.#handlers.set(type, fn);
+    return this;
+  }
+
+  has(type) {
+    return this.#handlers.has(type);
+  }
+
+  /**
+   * Odgrywa rundę.
+   * @param {object} response odpowiedź POST /api/slots/{code}/spins
+   * @param {{tempo?: number, autoplay?: boolean, token?: SkipToken}} o
+   */
+  async play(response, { tempo = 1, autoplay = false, token = new SkipToken() } = {}) {
+    const steps = Array.isArray(response?.steps) ? response.steps : [];
+    const ctx = {
+      response,
+      steps,
+      index: -1,
+      bet: response.bet,
+      tempo,
+      autoplay,
+      skip: token,
+      state: {},
+      shownWin: 0,
+      /** Kroki danego typu po bieżącym (np. win sprawdza, czy w rundzie jest jeszcze feature). */
+      next: (type) => steps.slice(ctx.index + 1).filter((s) => !type || s.type === type),
+      /** Kroki danego typu w całej rundzie. */
+      all: (type) => steps.filter((s) => s.type === type),
+    };
+    this.ctx = ctx;
+    this.playing = true;
+    // ziarno efektów z identyfikatora rundy (04 R10: ta sama runda wygląda zawsze tak samo)
+    fxRng.reseed(`${response.roundId ?? Date.now()}:${response.seed ?? ''}`);
+    this.dispatchEvent(new CustomEvent('round', { detail: { phase: 'start', response } }));
+    try {
+      await this.#hooks.beforeRound?.(ctx);
+      for (let i = 0; i < steps.length; i++) {
+        ctx.index = i;
+        const step = steps[i];
+        await this.#hooks.beforeStep?.(step, ctx);
+        const handler = this.#handlers.get(step.type) ?? this.#defaultHandler(step.type);
+        this.dispatchEvent(new CustomEvent('step', { detail: { step, index: i } }));
+        await handler(step, ctx);
+        if (typeof step.totalWin === 'number') ctx.shownWin = Math.max(ctx.shownWin, step.totalWin);
+        await this.#hooks.afterStep?.(step, ctx);
+      }
+      await this.#hooks.afterRound?.(ctx);
+    } finally {
+      this.playing = false;
+      this.dispatchEvent(new CustomEvent('round', { detail: { phase: 'end', response } }));
+    }
+    return ctx;
+  }
+
+  #defaultHandler(type) {

+      root.addChildAt(this.amountRays.root, 0);
+    }
+    if (this.gameApp.motion.reduced) {
+      root.scale.set(1);
+      return;
+    }
+    if (medium) tw.tween(300, (e) => root.scale.set(punch(0.2)(e)));
+    else tw.tween(250, (e) => root.scale.set(0.6 + 0.4 * e), { ease: easeOutBack(1.7) });
+  }
+
+  /** Pole „WYGRANA” liczy synchronicznie (04 § 2.17): wartość(t) = round(W · easeOutQuart(t / T)). */
+  #countPanel(from, to, T, token, ticking) {
+    const tw = this.gameApp.tweener;
+    let last = -1;
+    return tw.tween(T, (e, u) => {
+      const v = Math.round(from + (to - from) * e);
+      if (v !== last) {
+        last = v;
+        this.ui.winField?.(v);
+      }
+      if (ticking) this.audio.counterProgress(u);
+    }, { ease: easeOutQuart, token, onComplete: () => this.ui.winField?.(to) }).promise;
+  }
+
+  async #drawLines(lineWins, ctx, { quiet, medium }) {
+    const tw = this.gameApp.tweener;
+    const gap = 350 * ctx.tempo;
+    for (let i = 0; i < lineWins.length; i++) {
+      const w = lineWins[i];
+      const line = this.lines.draw(w.line, { tempo: ctx.tempo, glowAlpha: medium ? 0.5 : 0.35 });
+      if (!quiet && (ctx.tempo >= 1 || i === 0)) this.audio.line(i + 1);
+      await this.onLinePresented(w, line, ctx);
+      if (i < lineWins.length - 1 && i < 4) await tw.wait(gap, { token: ctx.skip });
+    }
+  }
+
+  /** Faza (b): każda linia osobno po 900 ms z kwotą przy środku, pozostałe przygaszone do 0,25 — do następnego spinu. */
+  async #cycleLines(lineWins) {
+    const token = new SkipToken();
+    this.cycleToken = token;
+    const tw = this.gameApp.tweener;
+    await tw.wait(600, { token });
+    while (!token.skipped) {
+      for (const w of lineWins) {
+        if (token.skipped) break;
+        this.lines.focus(w.line);
+        const c = this.lines.centerOf(w.line);
+        if (c) {
+          this.lineAmount.text = formatSigned(w.amount);
+          this.lineAmount.root.position.set(c.x, c.y - this.reels.cell * 0.32);
+          this.lineAmount.root.visible = true;
+          this.lineAmount.root.alpha = 0;
+          tw.to(this.lineAmount.root, { alpha: 1 }, { duration: 160 });
+        }
+        for (const [r, row] of w.positions ?? []) {
+          const s = this.presentation?.lifted.find((l) => l.r === r && l.row === row)?.slot;
+          if (s) this.#pulse(s, this.gameApp.motion.reduced ? 1.04 : 1.08);
+        }
+        await tw.wait(900, { token });
+      }
+    }
+    this.lineAmount.root.visible = false;
+  }
+
+  /** Gaszenie prezentacji przed kolejnym spinem (E24: linie, obrysy i przyciemnienie gasną w 120 ms). */
+  clearPresentation({ keepRound = false } = {}) {
+    this.cycleToken?.skip();
+    this.cycleToken = null;
+    if (!keepRound) this.presentToken?.skip();
+    this.lines.clear(120);
+    this.gameApp.tweener.killTweensOf(this.dimRect);
+    this.gameApp.tweener.to(this.dimRect, { alpha: 0 }, { duration: 120 });
+    for (const l of this.presentation?.lifted ?? []) {
+      if (l.glow) this.winGlows.release(l.glow);
+      this.gameApp.tweener.killTweensOf(l.slot.root);
+    }
+    this.presentation = null;
+    this.reels.dropAll();
+    this.amountRoot.visible = false;
+    this.amountRays.hide(120);
+    this.lineAmount.root.visible = false;
+  }
+
+  /**
+   * Komunikat na środku sceny (domyślne handlery S2/S3: darmowe spiny, mnożnik, funkcja specjalna).
+   * Obraz z manifestu (np. `g_win_free_spins`) albo złoty napis z kodu.
+   */
+  async showMessage(text, { ms = 1500, token, texture = null } = {}) {
+    const { PIXI } = this;
+    const ga = this.gameApp;
+    const tw = ga.tweener;
+    const { w, h } = ga.layout;
+    const root = new PIXI.Container();
+    const shade = new PIXI.Sprite(PIXI.Texture.WHITE);
+    shade.tint = 0x07060f;
+    shade.width = w;
+    shade.height = h;
+    shade.alpha = 0;
+    root.addChild(shade);
+    let label;
+    if (texture) {
+      label = new PIXI.Sprite(texture);
+      label.anchor.set(0.5);
+      label.scale.set(Math.min((w * 0.8) / texture.width, (h * 0.4) / texture.height));
+    } else {
+      label = new PIXI.Text({
+        text,
+        style: {
+          fontFamily: 'Cinzel, Georgia, serif', fontWeight: '900', fontSize: Math.max(28, Math.min(w, h) * 0.09), align: 'center',
+          fill: new PIXI.FillGradient({ type: 'linear', start: { x: 0, y: 0 }, end: { x: 0, y: 1 }, colorStops: [{ offset: 0, color: '#FFF6D6' }, { offset: 0.5, color: '#F5C542' }, { offset: 1, color: '#B8860B' }], textureSpace: 'local' }),
+          stroke: { color: '#3D2700', width: 6 }, dropShadow: { color: '#F5C542', blur: 18, distance: 0, alpha: 0.7 },
+          wordWrap: true, wordWrapWidth: w * 0.86,
+        },
+      });
+      label.anchor.set(0.5);
+    }
+    label.position.set(w / 2, h * 0.45);
+    root.addChild(label);
+    ga.layers.bigwin.addChild(root);
+    const s0 = label.scale.x;
+    tw.to(shade, { alpha: 0.55 }, { duration: 200 });
+    tw.tween(320, (e) => label.scale.set(s0 * (0.3 + 0.7 * e)), { ease: easeOutBack(1.5) });
+    this.particles.sparks('fxAdd', w / 2, h * 0.45, this.particles.count([40, 24, 10]), { tint: 0xffe08a });
+    await tw.wait(ms, { token });
+    await tw.to(root, { alpha: 0 }, { duration: 250 }).promise;
+    root.destroy({ children: true });
+  }
+
+  /** Dane do testów e2e i panelu ?fx=debug. */
+  debugInfo() {
+    return {
+      quality: this.gameApp.quality.level,
+      p90: this.gameApp.quality.p90,
+      fps: this.gameApp.quality.fps,
+      particles: this.particles.alive,
+      trauma: Number(this.camera.trauma.toFixed(2)),
+      flashMaxPerSecond: this.governor.maxPerSecond(),
+      heroSkips: this.governor.heroSkips(),
+      stats: { ...this.stats },
+    };
+  }
+}
+
diff --git a/src/main/resources/static/js/game/controller.js b/src/main/resources/static/js/game/controller.js
new file mode 100644
index 0000000..64a9d0b
--- /dev/null
+++ b/src/main/resources/static/js/game/controller.js
@@ -0,0 +1,492 @@
+/**
+ * game/controller.js — panel sterowania (HTML nad płótnem) i przebieg rundy.
+ *
+ * Stany: 'intro' → 'ready' → 'spinning' (bębny kręcą się, czekamy na serwer) → 'presenting' (odgrywanie kroków) → 'ready'.
+ * Zasady (do obrony):
+ *   * SPIN rusza bębny w TEJ SAMEJ klatce (E24) — żądanie POST /api/slots/{code}/spins idzie równolegle,
+ *     z nowym `Idempotency-Key` (crypto.randomUUID()) na każde kliknięcie,
+ *   * saldo: przy starcie spinu od razu odejmujemy zakład (gracz widzi, ile postawił), a wartość z serwera
+ *     (`balanceAfter`) księgujemy w chwili zakończenia liczenia wygranej (E28/E29) albo przylotu licznika Big Win
+ *     do panelu (E32) — liczba w pasku zgadza się z tym, co widać na ekranie (04 § 5.5),
+ *   * ten sam przycisk: SPIN → STOP (szybkie zatrzymanie) → przewinięcie prezentacji; Spacja działa tak samo,
+ *     dotknięcie sceny przewija Big Win (skip),
+ *   * błędy: INSUFFICIENT_FUNDS → okno z bonusem ratunkowym (gdy dostępny), błąd sieci → toast, bębny łagodnie
+ *     stają na planszy sprzed spinu (nie wymyślamy wyniku — E40) i gra wraca do gotowości.
+ */
+
+import { api, messageFor, newIdempotencyKey } from '../api.js';
+import { store } from '../store.js';
+import { sessionLost } from '../session.js';
+import { audio } from '../audio/audio-engine.js';
+import { BalanceCounter } from '../ui/balance.js';
+import { openModal, closeModal, isModalOpen } from '../ui/modal.js';
+import { toast } from '../ui/toast.js';
+import { formatAmount } from '../format.js';
+
+const $ = (s) => document.querySelector(s);
+const storage = {
+  get(k) { try { return localStorage.getItem(k); } catch { return null; } },
+  set(k, v) { try { localStorage.setItem(k, v); } catch { /* tryb prywatny */ } },
+};
+
+/** Wzorce wibracji z 04 § 1.6. */
+const HAPTICS = {
+  H_tik: [8], H_lekki: [14], H_sredni: [24], H_mocny: [40], H_podwojny: [20, 60, 30], H_serce: [28, 110, 16],
+  H_fanfara: [30, 40, 30, 40, 70], H_eskalacja: [50, 30, 90], H_blad: [25, 50, 25],
+};
+
+export class GameController {
+  state = 'intro';
+  responses = [];
+  #autoplay = null;
+  #pendingResolution = false;
+  #lastHaptic = 0;
+  #interacted = false;
+
+  /**
+   * @param {{code: string, slot: object, gameApp: object, game: object}} o
+   */
+  constructor({ code, slot, gameApp, game }) {
+    this.code = code;
+    this.slot = slot;
+    this.gameApp = gameApp;
+    this.game = game;
+    this.el = {
+      spin: $('#btn-spin'), spinCount: $('#spin-licznik'), auto: $('#btn-auto'), autoMenu: $('#auto-menu'), autoStart: $('#auto-start'),
+      turbo: $('#btn-turbo'), minus: $('#bet-minus'), plus: $('#bet-plus'), bet: $('#bet-wartosc'), win: $('#wygrana'),
+      panel: $('#panel'), stage: $('#scena'), lobby: $('#btn-lobby'), announce: $('#ogloszenia'), fs: $('#gra-fs'), skipHint: $('#gra-skip'),
+      funds: $('#modal-srodki'), fundsText: $('#srodki-opis'), fundsNote: $('#srodki-uwaga'), rescue: $('#btn-ratunek-gra'), lower: $('#btn-zmniejsz'),
+      settings: $('#modal-ustawienia'), settingsBtn: $('#btn-ustawienia'), qualityNote: $('#ust-jakosc-opis'), haptics: $('#ust-wibracje'),
+    };
+    this.counters = [$('#saldo'), $('#saldo-panel')].filter(Boolean).map((p) => new BalanceCounter(p));
+    this.levels = slot.betLevels?.length ? slot.betLevels : [slot.minBet];
+    const saved = Number(storage.get(`cebulion.zaklad.${code}`));
+    this.betIndex = Math.max(0, this.levels.indexOf(saved));
+    this.turbo = storage.get('cebulion.turbo') === '1';
+    this.hapticsOn = storage.get('cebulion.haptyka') !== '0';
+    this.balance = store.player?.balance ?? 0;
+    this.counters.forEach((c) => c.set(this.balance, { animate: false }));
+    this.#bind();
+    this.#renderBet();
+    this.#renderTurbo();
+    this.#exposeForTests();
+  }
+
+  get bet() {
+    return this.levels[this.betIndex];
+  }
+
+  get tempo() {
+    return this.turbo ? 0.45 : 1;
+  }
+
+  /** Callbacki dla gry (BaseGame.ui). */
+  uiCallbacks() {
+    return {
+      winField: (v) => { this.el.win.textContent = formatAmount(v); },
+      book: () => this.#book(),
+      dim: (on) => {
+        this.el.panel.classList.toggle('is-dimmed', on);
+        this.el.skipHint.hidden = !on;
+      },
+      panelTarget: () => {
+        const c = this.gameApp.app.canvas.getBoundingClientRect();
+        const r = this.el.win.getBoundingClientRect();
+        if (!r.width) return null;
+        return { x: r.left + r.width / 2 - c.left, y: r.top + r.height / 2 - c.top };
+      },
+      announce: (text) => { this.el.announce.textContent = text; },
+      haptic: (id) => this.#haptic(id),
+      freeSpins: (info) => {
+        this.el.fs.hidden = !info;
+        if (info) this.el.fs.textContent = info.left === 0 ? 'OSTATNI DARMOWY SPIN' : `DARMOWE SPINY: ${info.left ?? info.total}`;
+      },
+    };
+  }
+
+  // ------------------------------------------------------------------------------------------- start
+
+  /** Po intro (E21): SPIN aktywny od 1000 ms intro (R7). */
+  ready() {
+    this.state = 'ready';
+    this.el.panel.classList.add('is-in');
+    this.#renderSpin();
+    this.el.spin.focus({ preventScroll: true });
+  }
+
+  // ------------------------------------------------------------------------------------------- spin
+
+  async spin() {
+    if (this.state !== 'ready') return;
+    if (this.balance < this.bet) {
+      this.#stopAutoplay('brak środków');
+      this.#showFunds();
+      return;
+    }
+    this.state = 'spinning';
+    const bet = this.bet;
+    const key = newIdempotencyKey();       // crypto.randomUUID() — nowy na każde kliknięcie
+    this.round = { bet, key, booked: false, before: this.balance };
+    this.el.win.textContent = '0';
+    this.counters.forEach((c) => c.set(this.balance - bet, { duration: 300 }));
+    this.el.spin.classList.remove('is-pressed');
+    void this.el.spin.offsetWidth;
+    this.el.spin.classList.add('is-pressed');
+    this.#haptic(this.#autoplay ? null : 'H_lekki');
+    this.game.startSpin({ tempo: this.tempo, autoplay: Boolean(this.#autoplay) });
+    this.#renderSpin();
+    let response;
+    try {
+      response = await api.spin(this.code, bet, key);
+    } catch (err) {
+      await this.#spinFailed(err);
+      return;
+    }
+    this.responses.push(response);
+    this.lastResponse = response;
+    this.round.response = response;
+    this.state = 'presenting';
+    this.#renderSpin();
+    try {
+      await this.game.play(response, { tempo: this.tempo, autoplay: Boolean(this.#autoplay) });
+    } catch (err) {
+      console.error('Błąd odgrywania rundy:', err);
+    }
+    this.#book();
+    this.state = 'ready';
+    this.#renderSpin();
+    this.#afterRound(response);
+  }
+
+  /** Księgowanie salda z odpowiedzi serwera (dokładnie raz na rundę). */
+  #book() {
+    const r = this.round;
+    if (!r?.response || r.booked) return;
+    r.booked = true;
+    const after = r.response.balanceAfter;
+    const delta = after - (r.before - r.bet);
+    this.balance = after;
+    this.counters.forEach((c) => {
+      c.set(after);
+      if (delta > 0) c.pulse();
+    });
+    store.updateBalance(after, 'spin');
+    this.#renderBet();
+  }
+
+  #afterRound(response) {
+    // zmiana rozdzielczości po zmianie poziomu jakości — tylko między rundami (04 § 2.2)
+    if (this.#pendingResolution) {
+      this.#pendingResolution = false;
+      this.gameApp.applyResolution();
+    }
+    this.gameApp.quality.maybeUpgrade();
+    if (!this.#autoplay) return;
+    const a = this.#autoplay;
+    a.left -= 1;
+    const unitWin = response.totalWin;
+    if (a.stopWin && unitWin >= a.stopWin * response.bet) return this.#stopAutoplay('wygrana', true);
+    if (a.left <= 0) return this.#stopAutoplay('limit', true);
+    if (this.balance < this.bet) return this.#stopAutoplay('brak środków', true);
+    this.#renderSpin();
+    setTimeout(() => {
+      if (this.#autoplay && this.state === 'ready' && !isModalOpen()) this.spin();
+    }, 260 * this.tempo);
+  }
+
+  async #spinFailed(err) {
+    const code = err?.code;
+    await this.game.abort();
+    this.counters.forEach((c) => c.set(this.balance, { duration: 300 }));
+    this.state = 'ready';
+    this.#renderSpin();
+    this.#stopAutoplay('błąd');
+    if (code === 'NOT_LOGGED_IN') {
+      sessionLost();
+      location.replace(`./?gra=${encodeURIComponent(this.code)}`);
+      return;
+    }
+    if (code === 'INSUFFICIENT_FUNDS') {
+      this.#showFunds();
+      return;
+    }
+    if (code === 'BET_INVALID') {
+      this.betIndex = 0;
+      this.#renderBet();
+    }
+    this.#haptic('H_blad');
+    toast({ type: 'error', title: code === 'BET_INVALID' ? 'Niedozwolony zakład' : 'Spin nie został rozegrany', message: messageFor(err) });
+    // runda mogła zostać rozliczona po stronie serwera (zerwane połączenie) — odświeżamy saldo z GET /api/me
+    api.me().then((p) => {
+      store.setPlayer(p, { reason: 'sync' });
+      this.balance = p.balance;
+      this.counters.forEach((c) => c.set(p.balance));
+      this.#renderBet();
+    }).catch(() => {});
+  }
+
+  /** SPIN / Spacja / dotknięcie: start, szybki stop albo przewinięcie (zależnie od stanu). */
+  primary() {
+    this.#markInteraction();
+    if (this.state === 'ready') {
+      if (this.#autoplay) return this.#stopAutoplay('gracz');
+      return this.spin();
+    }
+    if (this.#autoplay && this.state !== 'intro') this.#stopAutoplay('gracz');
+    if (this.state === 'spinning' || this.state === 'presenting') this.game.skip();
+    return undefined;
+  }
+
+  // ------------------------------------------------------------------------------------------- autoplay (E38)
+
+  #toggleAutoMenu(open = this.el.autoMenu.hidden) {
+    if (this.#autoplay) {
+      this.#stopAutoplay('gracz');
+      return;
+    }
+    this.el.autoMenu.hidden = !open;
+    this.el.auto.setAttribute('aria-expanded', String(open));
+    if (open) this.el.autoMenu.querySelector('input:checked')?.focus();
+  }
+
+  #startAutoplay() {
+    const n = Number(this.el.autoMenu.querySelector('input[name="auto-ile"]:checked')?.value ?? 10);
+    const stopWin = Number(this.el.autoMenu.querySelector('input[name="auto-stop"]:checked')?.value ?? 0);
+    this.el.autoMenu.hidden = true;
+    this.#autoplay = { left: n, total: n, stopWin };
+    this.el.auto.setAttribute('aria-pressed', 'true');
+    audio.play('ui_przelacznik', { detune: 200 });
+    this.#haptic('H_tik');
+    this.#renderSpin();
+    if (this.state === 'ready') this.spin();
+  }
+
+  #stopAutoplay(reason, byCondition = false) {
+    if (!this.#autoplay) return;
+    this.#autoplay = null;
+    this.el.auto.setAttribute('aria-pressed', 'false');
+    audio.play(byCondition ? 'ui_zamknij' : 'ui_przelacznik', { detune: byCondition ? 0 : -200 });
+    this.#renderSpin();
+    if (byCondition && reason !== 'limit') toast({ type: 'info', title: 'Autoplay zatrzymany', message: reason === 'wygrana' ? 'Osiągnięto ustawioną wygraną.' : 'Za mało cebulionów na kolejny spin.', duration: 2600 });
+  }
+
+  get autoplayActive() {
+    return Boolean(this.#autoplay);
+  }
+
+  // ------------------------------------------------------------------------------------------- zakład, turbo, ustawienia
+
+  changeBet(step) {
+    if (this.state !== 'ready' || this.#autoplay) return;
+    const next = Math.min(this.levels.length - 1, Math.max(0, this.betIndex + step));
+    if (next === this.betIndex) return;
+    this.betIndex = next;
+    storage.set(`cebulion.zaklad.${this.code}`, String(this.bet));
+    audio.play(step > 0 ? 'ui_zaklad_gora' : 'ui_zaklad_dol', { detune: next * 100 });   // E23: +100 c × poziom
+    this.#haptic('H_tik');
+    this.el.bet.classList.remove('is-roll-up', 'is-roll-down');
+    void this.el.bet.offsetWidth;
+    this.el.bet.classList.add(step > 0 ? 'is-roll-up' : 'is-roll-down');
+    this.#renderBet();
+  }
+
+  #renderBet() {
+    this.el.bet.textContent = formatAmount(this.bet);
+    const busy = this.state !== 'ready' || Boolean(this.#autoplay);
+    this.el.minus.disabled = busy || this.betIndex === 0;
+    this.el.plus.disabled = busy || this.betIndex === this.levels.length - 1;
+    const tooHigh = this.balance < this.bet;
+    this.el.bet.classList.toggle('is-too-high', tooHigh);
+    this.el.bet.classList.toggle('is-max', this.betIndex === this.levels.length - 1);
+    this.el.bet.title = tooHigh ? 'Za mało cebulionów na ten zakład' : '';
+  }
+
+  #renderTurbo() {
+    this.el.turbo.setAttribute('aria-pressed', String(this.turbo));
+  }
+
+  #renderSpin() {
+    const s = this.state;
+    const spin = this.el.spin;
+    const stopping = s === 'spinning' || (s === 'presenting' && this.game.bigWinActive);
+    spin.classList.toggle('is-stop', s === 'spinning');
+    spin.classList.toggle('is-auto', Boolean(this.#autoplay));
+    spin.disabled = s === 'intro';
+    spin.setAttribute('aria-label', s === 'spinning' ? 'Zatrzymaj bębny (spacja)' : stopping ? 'Przewiń (spacja)' : this.#autoplay ? 'Zatrzymaj autoplay' : 'Zakręć (spacja)');
+    this.el.spinCount.hidden = !this.#autoplay;
+    if (this.#autoplay) this.el.spinCount.textContent = String(this.#autoplay.left);
+    this.el.lobby.classList.toggle('is-disabled', s !== 'ready');
+    this.el.lobby.setAttribute('aria-disabled', String(s !== 'ready'));
+    this.#renderBet();
+  }
+
+  #showFunds() {
+    const p = store.player;
+    this.el.fundsText.textContent = `Saldo ${formatAmount(this.balance)} nie wystarcza na zakład ${formatAmount(this.bet)}.`;
+    const canLower = this.levels.some((l) => l <= this.balance) && this.betIndex > 0;
+    this.el.lower.hidden = !canLower;
+    this.el.rescue.hidden = true;
+    this.el.fundsNote.textContent = '';
+    openModal(this.el.funds);
+    audio.play('ui_blad');
+    // stan bonusu ratunkowego z serwera (canRescue / rescueAvailableInSeconds — kontrakt 09 § 2.1)
+    api.me().then((player) => {
+      store.setPlayer(player, { reason: 'sync' });
+      this.el.rescue.hidden = !player.canRescue;
+      if (!player.canRescue && player.balance < player.minBet && player.rescueAvailableInSeconds > 0) {
+        this.el.fundsNote.textContent = `Bonus ratunkowy będzie dostępny za ${Math.ceil(player.rescueAvailableInSeconds / 60)} min.`;
+      }
+    }).catch(() => {});
+    void p;
+  }
+
+  async #rescue() {
+    this.el.rescue.disabled = true;
+    try {
+      const res = await api.rescue();
+      store.setPlayer(res.player, { reason: 'rescue' });
+      this.balance = res.player.balance;
+      this.counters.forEach((c) => { c.set(this.balance); c.pulse(); c.showDelta(res.amount); });
+      audio.play('sfx_saldo_puls');
+      closeModal(this.el.funds, 'success');
+      toast({ type: 'bonus', title: `+${formatAmount(res.amount)} cebulionów`, message: 'Bonus ratunkowy odebrany. Powodzenia!' });
+      this.#renderBet();
+    } catch (err) {
+      toast({ type: 'error', title: 'Bonus niedostępny', message: messageFor(err) });
+    } finally {
+      this.el.rescue.disabled = false;
+    }
+  }
+
+  #openSettings() {
+    const q = this.gameApp.quality;
+    for (const input of this.el.settings.querySelectorAll('input[name="jakosc"]')) input.checked = input.value === q.mode;
+    for (const input of this.el.settings.querySelectorAll('input[name="ruch"]')) input.checked = input.value === this.gameApp.motion.setting;
+    this.el.haptics.checked = this.hapticsOn;
+    this.#qualityNote();
+    openModal(this.el.settings);
+    audio.play('ui_otworz');
+  }
+
+  #qualityNote() {
+    const q = this.gameApp.quality;
+    const names = { high: 'wysoka', medium: 'średnia', low: 'niska' };
+    this.el.qualityNote.textContent = q.mode === 'auto'
+      ? `Teraz: ${names[q.level]} (automat dobiera poziom po pomiarze płynności${q.p90 ? `, p90 klatki ${q.p90.toFixed(1)} ms` : ''}).`
+      : `Wybrano ręcznie: ${names[q.level]}.`;
+  }
+
+  #haptic(id) {
+    if (!id || !this.hapticsOn || !this.#interacted || document.hidden) return;
+    if (!navigator.vibrate || !matchMedia('(pointer: coarse)').matches) return;
+    const now = performance.now();
+    if (now - this.#lastHaptic < 120) return;      // najwyżej jeden wzorzec na 120 ms, bez kolejki (04 § 1.6)
+    this.#lastHaptic = now;
+    try { navigator.vibrate(HAPTICS[id] ?? [10]); } catch { /* brak wsparcia */ }
+  }
+
+  #markInteraction() {
+    this.#interacted = true;
+  }
+
+  // ------------------------------------------------------------------------------------------- zdarzenia
+
+  #bind() {
+    const e = this.el;
+    e.spin.addEventListener('click', () => this.primary());
+    e.minus.addEventListener('click', () => this.changeBet(-1));
+    e.plus.addEventListener('click', () => this.changeBet(1));
+    e.auto.addEventListener('click', () => { this.#markInteraction(); this.#toggleAutoMenu(); });
+    e.autoStart.addEventListener('click', () => this.#startAutoplay());
+    e.turbo.addEventListener('click', () => {
+      this.turbo = !this.turbo;
+      storage.set('cebulion.turbo', this.turbo ? '1' : '0');
+      this.#renderTurbo();
+      audio.play('ui_przelacznik', { detune: this.turbo ? 200 : -200 });   // E39
+      this.#haptic('H_tik');
+      e.turbo.classList.remove('is-flash');
+      void e.turbo.offsetWidth;
+      if (this.turbo) e.turbo.classList.add('is-flash');
+    });
+    e.settingsBtn.addEventListener('click', () => this.#openSettings());
+    e.settings.addEventListener('change', (ev) => {
+      const t = ev.target;
+      if (t.name === 'jakosc') {
+        this.gameApp.quality.setMode(t.value);
+        this.#qualityNote();
+      } else if (t.name === 'ruch') this.gameApp.motion.set(t.value);
+      else if (t.id === 'ust-wibracje') {
+        this.hapticsOn = t.checked;
+        storage.set('cebulion.haptyka', t.checked ? '1' : '0');
+      }
+      audio.play('ui_przelacznik');
+    });
+    e.rescue.addEventListener('click', () => this.#rescue());
+    e.lower.addEventListener('click', () => {
+      const idx = this.levels.reduce((best, l, i) => (l <= this.balance ? i : best), 0);
+      this.betIndex = idx;
+      storage.set(`cebulion.zaklad.${this.code}`, String(this.bet));
+      this.#renderBet();
+      closeModal(e.funds, 'lower');
+    });
+    // dotknięcie sceny: przewinięcie Big Win / szybki stop (04 § 4.5)
+    e.stage.addEventListener('pointerdown', (ev) => {
+      if (ev.target.closest('button, a, .loader')) return;
+      this.#markInteraction();
+      if (this.state === 'spinning' || this.state === 'presenting') this.game.skip();
+    });
+    document.addEventListener('pointerdown', (ev) => {
+      if (!e.autoMenu.hidden && !ev.target.closest('.auto-wrap')) this.#toggleAutoMenu(false);
+    });
+    // skróty: Spacja = SPIN / stop / przewinięcie, + / − = zakład, Esc = zamknięcie menu AUTO / stop autoplay
+    document.addEventListener('keydown', (ev) => {
+      if (isModalOpen() || ev.repeat) return;
+      if (ev.target.closest?.('input, textarea, select, [contenteditable="true"]')) return;
+      if (ev.code === 'Space' || ev.code === 'Enter') {
+        if (ev.target.closest?.('button, a') && ev.target !== e.spin) return;   // spacja na innym przycisku = jego kliknięcie
+        ev.preventDefault();
+        this.primary();
+      } else if (ev.key === '+' || ev.key === '=' || ev.code === 'NumpadAdd') {
+        ev.preventDefault();
+        this.changeBet(1);
+      } else if (ev.key === '-' || ev.code === 'NumpadSubtract') {
+        ev.preventDefault();
+        this.changeBet(-1);
+      } else if (ev.key === 'Escape') {
+        if (!e.autoMenu.hidden) this.#toggleAutoMenu(false);
+        else if (this.#autoplay) this.#stopAutoplay('gracz');
+      }
+    });
+    // przejście gra → lobby (E12) — tylko między rundami
+    e.lobby.addEventListener('click', (ev) => {
+      if (ev.metaKey || ev.ctrlKey) return;
+      ev.preventDefault();
+      if (this.state !== 'ready') return;
+      audio.play('sfx_przejscie_whoosh');
+      audio.stopMusic(220);
+      document.body.classList.add('is-leaving');
+      setTimeout(() => { location.href = e.lobby.href; }, 220);
+    });
+    this.gameApp.quality.addEventListener('change', () => {
+      if (this.state === 'ready') this.gameApp.applyResolution();
+      else this.#pendingResolution = true;
+    });
+  }
+
+  /** Punkt kontrolny dla testów e2e (tools/e2e/gra-s1.mjs) i panelu ?fx=debug — tylko odczyt. */
+  #exposeForTests() {
+    const self = this;
+    window.__gra = {
+      get state() { return self.state; },
+      get responses() { return self.responses; },
+      get lastResponse() { return self.lastResponse; },
+      get autoplay() { return self.autoplayActive; },
+      get displayedBalance() { return self.counters[0]?.target; },
+      get shownBalanceText() { return document.querySelector('#saldo .balance-pill__value')?.textContent; },
+      get bigWin() { return self.game.bigWinActive; },
+      debug: () => self.game.debugInfo(),
+      flashLog: () => self.game.governor.log,
+      qualityLog: () => self.gameApp.quality.log,
+    };
+  }
+}
diff --git a/src/main/resources/static/js/game/core/app.js b/src/main/resources/static/js/game/core/app.js
new file mode 100644
index 0000000..3d53f4f
--- /dev/null
+++ b/src/main/resources/static/js/game/core/app.js
@@ -0,0 +1,205 @@
+/**
+ * game/core/app.js — aplikacja PixiJS gry: płótno, warstwy renderu, układ (skala sceny), pętla gry.
+ *
+ * Najważniejsze decyzje (do obrony):
+ *   * `resizeTo` = element sceny, `autoDensity` i rozdzielczość = min(DPR, limit poziomu jakości) — na ekranie
+ *     Retina obraz jest ostry, ale nie renderujemy 3× więcej pikseli, niż trzeba (brief § 5: DPR ≤ 2 / 1,5 / 1).
+ *   * Warstwy L0–L14 jak w 04 § 7.2. Kontener `world` (L0–L11) drży przy uderzeniach; Big Win (L12) dostaje 35%
+ *     drżenia, a licznik wygranej 0% (reguła R1 „wynik jest święty”).
+ *   * Pętla: jeden ticker, stała kolejność prac w klatce (04 § 7.3). Najpierw cała LOGIKA (zegar, osie czasu,
+ *     bębny, tweeny, cząsteczki, kamera), potem Pixi RYSUJE gotowy stan — logika nigdy nie dzieje się w trakcie
+ *     rysowania. `deltaMS` przycinamy do 50 ms, żeby po zacięciu przeglądarki animacje nie „przeskakiwały”.
+ *   * Ukryta karta → ticker staje (oszczędność baterii; zegar gry stoi, więc oczekiwania też). Utrata kontekstu
+ *     WebGL (sterownik, przełączenie karty graficznej) → pauza i komunikat; po odzyskaniu Pixi wgrywa tekstury
+ *     ponownie, a my wznawiamy pętlę.
+ */
+
+import { Tweener } from './tween.js';
+
+const PIXI_URL = new URL('../../../vendor/pixi/pixi.min.mjs', import.meta.url).href;
+const LAYER_NAMES = ['bg', 'bgParticles', 'under', 'reels', 'dim', 'wins', 'lines', 'frame', 'logo', 'fxNormal', 'fxAdd', 'amounts'];
+
+export class GameApp extends EventTarget {
+  /** @type {typeof import('pixi.js')} */ PIXI = null;
+  app = null;
+  tweener = new Tweener();
+  layers = {};
+  /** Układ sceny w pikselach CSS: szerokość, wysokość, orientacja, skala referencyjna k (widok 1920×1080). */
+  layout = { w: 1, h: 1, portrait: false, k: 1, short: 1 };
+  #systems = [];
+  #lastW = 0;
+  #lastH = 0;
+  #resizeObserver = null;
+  #contextLost = false;
+  frameMs = 16.7;
+
+  constructor({ container, quality, motion }) {
+    super();
+    this.container = container;
+    this.quality = quality;
+    this.motion = motion;
+  }
+
+  /** Ładuje Pixi (dynamicznie — lobby go nie pobiera) i tworzy płótno. */
+  async init() {
+    this.PIXI = await import(PIXI_URL);
+    const { Application, Container } = this.PIXI;
+    const app = new Application();
+    await app.init({
+      resizeTo: this.container,
+      backgroundAlpha: 0,
+      antialias: false,            // bez MSAA: krawędzie wygładzają miękkie tekstury (04 § 2.16), a GPU ma mniej pracy
+      autoDensity: true,
+      resolution: this.#resolution(),
+      preference: 'webgl',
+      powerPreference: 'high-performance',
+      hello: false,
+    });
+    this.app = app;
+    this.renderer = app.renderer;
+    app.canvas.setAttribute('aria-hidden', 'true');
+    app.canvas.classList.add('stage__canvas');
+    this.container.prepend(app.canvas);
+
+    // --- warstwy (04 § 7.2) ---
+    const world = new Container({ label: 'world' });
+    for (const name of LAYER_NAMES) {
+      const layer = new Container({ label: name });
+      world.addChild(layer);
+      this.layers[name] = layer;
+    }
+    const bigwin = new Container({ label: 'bigwin' });
+    const bigwinFixed = new Container({ label: 'bigwinFixed' });
+    const flash = new Container({ label: 'flash' });
+    const overlay = new Container({ label: 'overlay' });
+    app.stage.addChild(world, bigwin, bigwinFixed, flash, overlay);
+    Object.assign(this.layers, { world, bigwin, bigwinFixed, flash, overlay });
+    this.layers.fxAdd.blendMode = 'add';
+    this.layers.lines.blendMode = 'add';
+
+    // --- pętla gry ---
+    app.ticker.add(this.#tick, this);
+    this.#watchSize();
+    this.#watchVisibility();
+    this.#watchContext();
+    this.#relayout(true);
+    return this;
+  }
+
+  #resolution() {
+    return Math.min(window.devicePixelRatio || 1, this.quality.params.dpr);
+  }
+
+  /**
+   * Rejestruje system aktualizowany co klatkę. Kolejność = `order` rosnąco (04 § 7.3):
+   * 10 osie czasu, 20 bębny, 30 tweeny, 40 cząsteczki, 50 kamera, 60 strażnik błysków.
+   */
+  addSystem(system, order = 35) {
+    this.#systems.push({ system, order });
+    this.#systems.sort((a, b) => a.order - b.order);
+    return system;
+  }
+
+  removeSystem(system) {
+    this.#systems = this.#systems.filter((s) => s.system !== system);
+  }
+
+  #tick(ticker) {
+    const raw = ticker.deltaMS;
+    const dt = Math.min(raw, 50);
+    this.frameMs = raw;
+    if (this.app.screen.width !== this.#lastW || this.app.screen.height !== this.#lastH) this.#relayout();
+    // tweener przed resztą — osie czasu i wait() są na nim oparte
+    this.tweener.update(dt);
+    const fxDt = this.tweener.lastFxDt;
+    for (const { system } of this.#systems) system.update(dt, fxDt);
+    this.quality.sample(raw);
+  }
+
+  /** Przelicza układ po zmianie rozmiaru (obrót telefonu, zmiana okna). */
+  #relayout(force = false) {
+    const w = this.app.screen.width;
+    const h = this.app.screen.height;
+    if (!force && w === this.#lastW && h === this.#lastH) return;
+    this.#lastW = w;
+    this.#lastH = h;
+    const portrait = h > w * 1.08;
+    // k — skala względem widoku referencyjnego 1920×1080 (04 § 1.7), liczona z krótszego boku
+    const k = portrait ? Math.min(w / 1080, h / 1920) : Math.min(w / 1920, h / 1080);
+    this.layout = { w, h, portrait, k: Math.max(0.2, k), short: Math.min(w, h) };
+    const { world } = this.layers;
+    world.pivot.set(w / 2, h / 2);
+    world.position.set(w / 2, h / 2);
+    this.dispatchEvent(new CustomEvent('resize', { detail: this.layout }));
+  }
+
+  #watchSize() {
+    // ResizePlugin Pixi słucha zdarzenia window.resize; element sceny zmienia rozmiar także bez niego
+    // (np. panel sterowania zmienia wysokość po zmianie orientacji) — dlatego dodatkowo ResizeObserver.
+    if ('ResizeObserver' in window) {
+      this.#resizeObserver = new ResizeObserver(() => {
+        if (typeof this.app.queueResize === 'function') this.app.queueResize();
+        else this.app.resize();
+      });
+      this.#resizeObserver.observe(this.container);
+    }
+  }
+
+  #watchVisibility() {
+    document.addEventListener('visibilitychange', () => {
+      if (!this.app) return;
+      if (document.hidden) this.app.ticker.stop();
+      else if (!this.#contextLost) {
+        this.quality.suspend(1000);   // pierwsze klatki po powrocie są długie — nie liczą się do automatu
+        this.app.ticker.start();
+      }
+      this.dispatchEvent(new CustomEvent('visibility', { detail: { hidden: document.hidden } }));
+    });
+  }
+
+  #watchContext() {
+    const canvas = this.app.canvas;
+    canvas.addEventListener('webglcontextlost', (e) => {
+      e.preventDefault();                 // bez tego przeglądarka nie spróbuje odzyskać kontekstu
+      this.#contextLost = true;
+      this.app.ticker.stop();
+      this.dispatchEvent(new CustomEvent('contextlost'));
+    });
+    canvas.addEventListener('webglcontextrestored', () => {
+      this.#contextLost = false;
+      this.quality.suspend(1500);
+      if (!document.hidden) this.app.ticker.start();
+      this.dispatchEvent(new CustomEvent('contextrestored'));
+    });
+  }
+
+  get contextLost() {
+    return this.#contextLost;
+  }
+
+  /** Zmiana rozdzielczości renderowania (wołana między rundami po zmianie poziomu jakości). */
+  applyResolution() {
+    const r = this.#resolution();
+    if (Math.abs(r - this.renderer.resolution) < 0.01) return false;
+    this.renderer.resize(this.app.screen.width, this.app.screen.height, r);
+    this.quality.suspend(800);
+    return true;
+  }
+
+  /**
+   * Wgrywa tekstury na GPU i kompiluje shadery na ekranie ładowania (04 E20) — pierwsze użycie tekstury w trakcie
+   * spinu dałoby zacięcie 50–200 ms.
+   */
+  async prepare(target) {
+    try {
+      await this.renderer.prepare?.upload(target ?? this.app.stage);
+    } catch {
+      /* brak systemu prepare — tekstury wgrają się przy pierwszym rysowaniu */
+    }
+  }
+
+  destroy() {
+    this.#resizeObserver?.disconnect();
+    this.app?.destroy(true, { children: true });
+  }
+}
diff --git a/src/main/resources/static/js/game/core/canvas-art.js b/src/main/resources/static/js/game/core/canvas-art.js
new file mode 100644
index 0000000..2eca065
--- /dev/null
+++ b/src/main/resources/static/js/game/core/canvas-art.js
@@ -0,0 +1,570 @@
+/**
+ * game/core/canvas-art.js — grafika efektów rysowana w kodzie (Canvas 2D), gdy w manifeście brak obrazu.
+ *
+ * Dlaczego Canvas 2D, a nie Pixi Graphics: Canvas ma prawdziwą poświatę (`shadowBlur`), gradienty radialne,
+ * tryby mieszania i fonty — rysujemy RAZ na ekranie ładowania, a potem to zwykłe tekstury (zero kosztu w klatce).
+ * Tekstury efektów są białe i barwione `tint` (04 § 2.3: jeden zestaw iskier obsługuje złote BIG WIN i cyjanowe S1).
+ *
+ * Atlasy: ParticleContainer z Pixi 8 wymaga JEDNEGO źródła tekstury na kontener (04 § 2.3). Dlatego składamy
+ * iskry/dym w atlas „fx” (mieszanie add), a monety/konfetti w atlas „normal” — także wtedy, gdy obrazy są
+ * w manifeście (rysujemy je wtedy do atlasu zamiast kształtów z kodu).
+ */
+
+export const GOLD_STOPS = [[0, '#FFF6D6'], [0.22, '#FFE08A'], [0.55, '#F5C542'], [0.82, '#C99A1E'], [1, '#8A5E05']];
+
+export function makeCanvas(w, h) {
+  const c = document.createElement('canvas');
+  c.width = Math.max(1, Math.round(w));
+  c.height = Math.max(1, Math.round(h));
+  return c;
+}
+
+/** Tekstura Pixi z płótna (z wygładzaniem liniowym i mipmapami dla dużych pomniejszeń). */
+export function canvasTexture(PIXI, canvas, { mipmap = false } = {}) {
+  const source = new PIXI.CanvasSource({ resource: canvas, autoGenerateMipmaps: mipmap, scaleMode: 'linear' });
+  return new PIXI.Texture({ source });
+}
+
+/** Gradient liniowy z listy [offset, kolor]. */
+export function linear(ctx, x0, y0, x1, y1, stops) {
+  const g = ctx.createLinearGradient(x0, y0, x1, y1);
+  for (const [o, c] of stops) g.addColorStop(o, c);
+  return g;
+}
+
+export function radial(ctx, x, y, r0, r1, stops) {
+  const g = ctx.createRadialGradient(x, y, r0, x, y, r1);
+  for (const [o, c] of stops) g.addColorStop(o, c);
+  return g;
+}
+
+/** Miękki biały punkt (poświata, bokeh, „żarówka”, błysk radialny). */
+function drawDot(ctx, x, y, w, h, hard = 0) {
+  const r = Math.min(w, h) / 2;
+  ctx.fillStyle = radial(ctx, x + w / 2, y + h / 2, 0, r, [[0, 'rgba(255,255,255,1)'], [hard, 'rgba(255,255,255,0.85)'], [0.45, 'rgba(255,255,255,0.32)'], [1, 'rgba(255,255,255,0)']]);
+  ctx.fillRect(x, y, w, h);
+}
+
+/** Gwiazdka n-ramienna z poświatą (iskry „atomic age”, 01 § 9.3). */
+function drawStar(ctx, x, y, w, h, points = 4, inner = 0.12) {
+  const cx = x + w / 2;
+  const cy = y + h / 2;
+  const R = Math.min(w, h) / 2;
+  drawDot(ctx, x + w * 0.2, y + h * 0.2, w * 0.6, h * 0.6);
+  ctx.save();
+  ctx.shadowColor = 'rgba(255,255,255,0.9)';
+  ctx.shadowBlur = R * 0.25;
+  ctx.fillStyle = '#fff';
+  ctx.beginPath();
+  for (let i = 0; i < points * 2; i++) {
+    const a = (Math.PI * i) / points - Math.PI / 2;
+    const rr = i % 2 === 0 ? R * 0.96 : R * inner;
+    ctx.lineTo(cx + Math.cos(a) * rr, cy + Math.sin(a) * rr);
+  }
+  ctx.closePath();
+  ctx.fill();
+  ctx.restore();
+}
+
+function drawStreak(ctx, x, y, w, h) {
+  const cy = y + h / 2;
+  ctx.fillStyle = linear(ctx, x, 0, x + w, 0, [[0, 'rgba(255,255,255,0)'], [0.7, 'rgba(255,255,255,0.75)'], [0.92, 'rgba(255,255,255,1)'], [1, 'rgba(255,255,255,0)']]);
+  ctx.beginPath();
+  ctx.ellipse(x + w / 2, cy, w / 2, h * 0.16, 0, 0, Math.PI * 2);
+  ctx.fill();
+  drawDot(ctx, x + w * 0.72, y + h * 0.3, w * 0.24, h * 0.4, 0.2);
+}
+
+function drawRing(ctx, x, y, w, h) {
+  const cx = x + w / 2;
+  const cy = y + h / 2;
+  const R = Math.min(w, h) / 2;
+  ctx.fillStyle = radial(ctx, cx, cy, R * 0.5, R, [[0, 'rgba(255,255,255,0)'], [0.55, 'rgba(255,255,255,0.95)'], [0.7, 'rgba(255,255,255,0.4)'], [1, 'rgba(255,255,255,0)']]);
+  ctx.fillRect(x, y, w, h);
+}
+
+/** Miękki kłąb dymu: kilka nakładających się kół z szumem (jasność ≤ 70% — 04 § 2.11). */
+function drawSmoke(ctx, x, y, w, h) {
+  const cx = x + w / 2;
+  const cy = y + h / 2;
+  let seed = 7;
+  const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
+  for (let i = 0; i < 14; i++) {
+    const a = rnd() * Math.PI * 2;
+    const d = rnd() * w * 0.2;
+    const r = w * (0.18 + rnd() * 0.16);
+    ctx.fillStyle = radial(ctx, cx + Math.cos(a) * d, cy + Math.sin(a) * d, 0, r, [[0, 'rgba(178,178,178,0.38)'], [1, 'rgba(178,178,178,0)']]);
+    ctx.fillRect(x, y, w, h);
+  }
+}
+
+/** Moneta cebulion z trzech ujęć (przód / skos / bok) — 04 § 2.3 „obrót z trzech ujęć”. */
+function drawCoin(ctx, x, y, w, h, squash) {
+  const cx = x + w / 2;
+  const cy = y + h / 2;
+  const R = Math.min(w, h) * 0.44;
+  ctx.save();
+  ctx.translate(cx, cy);
+  ctx.scale(squash, 1);
+  // krawędź (grubość) widoczna przy pochyleniu
+  if (squash < 0.95) {
+    ctx.fillStyle = '#8A5E05';
+    ctx.beginPath();
+    ctx.ellipse(R * 0.12 / squash, 0, R, R, 0, 0, Math.PI * 2);
+    ctx.fill();
+  }
+  ctx.fillStyle = radial(ctx, -R * 0.3, -R * 0.35, R * 0.1, R * 1.2, [[0, '#FFF6D6'], [0.35, '#FFD75A'], [0.75, '#D9A21C'], [1, '#8A5E05']]);
+  ctx.beginPath();
+  ctx.arc(0, 0, R, 0, Math.PI * 2);
+  ctx.fill();
+  ctx.strokeStyle = 'rgba(92,58,0,0.85)';
+  ctx.lineWidth = R * 0.08;
+  ctx.beginPath();
+  ctx.arc(0, 0, R * 0.8, 0, Math.PI * 2);
+  ctx.stroke();
+  // wytłoczona cebula (uproszczona sylwetka)
+  ctx.fillStyle = 'rgba(120,78,0,0.55)';
+  ctx.beginPath();
+  ctx.moveTo(0, -R * 0.5);
+  ctx.bezierCurveTo(R * 0.12, -R * 0.3, R * 0.45, -R * 0.15, R * 0.4, R * 0.15);
+  ctx.bezierCurveTo(R * 0.36, R * 0.42, -R * 0.36, R * 0.42, -R * 0.4, R * 0.15);
+  ctx.bezierCurveTo(-R * 0.45, -R * 0.15, -R * 0.12, -R * 0.3, 0, -R * 0.5);
+  ctx.fill();
+  ctx.fillStyle = 'rgba(255,255,255,0.55)';
+  ctx.beginPath();
+  ctx.ellipse(-R * 0.35, -R * 0.4, R * 0.28, R * 0.12, -0.6, 0, Math.PI * 2);
+  ctx.fill();
+  ctx.restore();
+}
+
+/** Białe kształty konfetti (barwione tintem: złoto, magenta, cyjan). */
+function drawConfetti(ctx, x, y, w, h, kind) {
+  ctx.save();
+  ctx.translate(x + w / 2, y + h / 2);
+  ctx.fillStyle = '#fff';
+  const s = Math.min(w, h);
+  switch (kind % 6) {
+    case 0: ctx.fillRect(-s * 0.4, -s * 0.22, s * 0.8, s * 0.44); break;
+    case 1: ctx.beginPath(); ctx.arc(0, 0, s * 0.3, 0, Math.PI * 2); ctx.fill(); break;
+    case 2: ctx.fillRect(-s * 0.45, -s * 0.1, s * 0.9, s * 0.2); break;
+    case 3: ctx.beginPath(); ctx.moveTo(0, -s * 0.4); ctx.lineTo(s * 0.38, s * 0.3); ctx.lineTo(-s * 0.38, s * 0.3); ctx.closePath(); ctx.fill(); break;
+    case 4: // serpentyna
+      ctx.strokeStyle = '#fff'; ctx.lineWidth = s * 0.14; ctx.lineCap = 'round';
+      ctx.beginPath(); ctx.moveTo(-s * 0.4, -s * 0.2);
+      ctx.bezierCurveTo(-s * 0.1, -s * 0.5, s * 0.1, s * 0.5, s * 0.4, s * 0.2); ctx.stroke(); break;
+    default: // gwiazdka
+      ctx.beginPath();
+      for (let i = 0; i < 10; i++) {
+        const a = (Math.PI * i) / 5 - Math.PI / 2;
+        const r = i % 2 ? s * 0.16 : s * 0.4;
+        ctx.lineTo(Math.cos(a) * r, Math.sin(a) * r);
+      }
+      ctx.fill();
+  }
+  // lekki połysk (konfetti z folii)
+  ctx.globalCompositeOperation = 'source-atop';
+  ctx.fillStyle = linear(ctx, -s / 2, -s / 2, s / 2, s / 2, [[0, 'rgba(255,255,255,0)'], [0.5, 'rgba(255,255,255,0.0)'], [0.55, 'rgba(0,0,0,0.18)'], [1, 'rgba(0,0,0,0.25)']]);
+  ctx.fillRect(-s / 2, -s / 2, s, s);
+  ctx.restore();
+}
+
+/** Rysuje obraz (np. teksturę z manifestu) do komórki atlasu, zachowując proporcje. */
+function drawImageFit(ctx, img, x, y, w, h) {
+  const iw = img.width || img.naturalWidth || w;
+  const ih = img.height || img.naturalHeight || h;
+  const s = Math.min(w / iw, h / ih);
+  ctx.drawImage(img, x + (w - iw * s) / 2, y + (h - ih * s) / 2, iw * s, ih * s);
+}
+
+/** Źródło obrazu tekstury Pixi (ImageBitmap / HTMLImageElement / canvas) do rysowania w atlasie. */
+function textureImage(texture) {
+  const r = texture?.source?.resource;
+  return r && (r instanceof ImageBitmap || r instanceof HTMLImageElement || r instanceof HTMLCanvasElement) ? r : null;
+}
+
+/**
+ * Prosty atlas półkowy: wpisy { name, w, h, draw(ctx, x, y, w, h) } → jedno płótno + ramki Texture.
+ * @returns {{texture: Texture, frames: Record<string, Texture>}}
+ */
+export function buildAtlas(PIXI, entries, width = 1024) {
+  const pad = 2;
+  let x = pad;
+  let y = pad;
+  let rowH = 0;
+  const placed = [];
+  for (const e of entries) {
+    if (x + e.w + pad > width) {
+      x = pad;
+      y += rowH + pad;
+      rowH = 0;
+    }
+    placed.push({ ...e, x, y });
+    x += e.w + pad;
+    rowH = Math.max(rowH, e.h);
+  }
+  const height = 1 << Math.ceil(Math.log2(y + rowH + pad));
+  const canvas = makeCanvas(width, height);
+  const ctx = canvas.getContext('2d');
+  for (const p of placed) {
+    ctx.save();
+    ctx.beginPath();
+    ctx.rect(p.x, p.y, p.w, p.h);
+    ctx.clip();
+    p.draw(ctx, p.x, p.y, p.w, p.h);
+    ctx.restore();
+  }
+  const base = canvasTexture(PIXI, canvas);
+  const frames = {};
+  for (const p of placed) {
+    frames[p.name] = new PIXI.Texture({ source: base.source, frame: new PIXI.Rectangle(p.x, p.y, p.w, p.h) });
+  }
+  return { texture: base, frames, canvas };
+}
+
+/**
+ * Atlas efektów `add` (białe, barwione tintem). Nazwy ramek odpowiadają komórkom `g_fx_iskry__0…7` z 04 § 2.3:
+ * 0,1,3,4,6 — iskry, 2 — miękki punkt (pył, bokeh, żarówki), 5 — smuga, 7 — pierścień; plus `smoke` (g_fx_dym).
+ */
+export function buildFxAtlas(PIXI, resources) {
+  const cell = 64;
+  const shapes = [
+    (c, x, y, w, h) => drawStar(c, x, y, w, h, 4, 0.1),
+    (c, x, y, w, h) => drawStar(c, x, y, w, h, 8, 0.25),
+    (c, x, y, w, h) => drawDot(c, x, y, w, h),
+    (c, x, y, w, h) => drawStar(c, x, y, w, h, 4, 0.22),
+    (c, x, y, w, h) => drawDot(c, x, y, w, h, 0.25),
+    (c, x, y, w, h) => drawStreak(c, x, y, w, h),
+    (c, x, y, w, h) => drawStar(c, x, y, w, h, 6, 0.18),
+    (c, x, y, w, h) => drawRing(c, x, y, w, h),
+  ];
+  const entries = shapes.map((draw, i) => {
+    const tex = resources?.texture(`g_fx_iskry__${i}`);
+    const img = textureImage(tex);
+    return { name: `iskra${i}`, w: cell, h: cell, draw: img ? (c, x, y, w, h) => drawImageFit(c, img, x, y, w, h) : draw };
+  });
+  const smokeImg = textureImage(resources?.texture('g_fx_dym'));
+  entries.push({ name: 'smoke', w: 128, h: 128, draw: smokeImg ? (c, x, y, w, h) => drawImageFit(c, smokeImg, x, y, w, h) : drawSmoke });
+  entries.push({ name: 'dotHard', w: 32, h: 32, draw: (c, x, y, w, h) => drawDot(c, x, y, w, h, 0.45) });
+  return buildAtlas(PIXI, entries, 512);
+}
+
+/** Atlas mieszania normalnego: monety (3 ujęcia) i 12 kształtów konfetti. */
+export function buildNormalAtlas(PIXI, resources) {
+  const coinIds = ['g_moneta_przod', 'g_moneta_skos', 'g_moneta_bok'];
+  const squash = [1, 0.62, 0.18];
+  const entries = coinIds.map((id, i) => {
+    const img = textureImage(resources?.texture(id, 'male') ?? resources?.texture(id));
+    return { name: `coin${i}`, w: 64, h: 64, draw: img ? (c, x, y, w, h) => drawImageFit(c, img, x, y, w, h) : (c, x, y, w, h) => drawCoin(c, x, y, w, h, squash[i]) };
+  });
+  for (let i = 0; i < 12; i++) {
+    const img = textureImage(resources?.texture(`g_fx_konfetti__${i}`));
+    entries.push({ name: `confetti${i}`, w: 32, h: 32, draw: img ? (c, x, y, w, h) => drawImageFit(c, img, x, y, w, h) : (c, x, y, w, h) => drawConfetti(c, x, y, w, h, i) });
+  }
+  return buildAtlas(PIXI, entries, 256);
+}
+
+/** Pojedyncze tekstury pomocnicze (generowane raz). */
+export function buildHelperTextures(PIXI) {
+  const tex = {};
+  // gradient radialny 256×256: błysk radialny, podkład pod licznikiem, słońce (04 § 2.4)
+  {
+    const c = makeCanvas(256, 256);
+    drawDot(c.getContext('2d'), 0, 0, 256, 256);
+    tex.radial = canvasTexture(PIXI, c);
+  }
+  // twardszy radialny (żarówki, punkty światła)
+  {
+    const c = makeCanvas(64, 64);
+    const x = c.getContext('2d');
+    x.fillStyle = radial(x, 32, 32, 0, 32, [[0, '#fff'], [0.3, 'rgba(255,255,255,0.95)'], [0.55, 'rgba(255,255,255,0.35)'], [1, 'rgba(255,255,255,0)']]);
+    x.fillRect(0, 0, 64, 64);
+    tex.bulb = canvasTexture(PIXI, c);
+  }
+  // winieta: przezroczysty środek → czarne brzegi (04 § 2.18)
+  {
+    const c = makeCanvas(512, 512);
+    const x = c.getContext('2d');
+    x.fillStyle = radial(x, 256, 256, 120, 362, [[0, 'rgba(0,0,0,0)'], [0.6, 'rgba(0,0,0,0.35)'], [1, 'rgba(0,0,0,1)']]);
+    x.fillRect(0, 0, 512, 512);
+    tex.vignette = canvasTexture(PIXI, c);
+  }
+  // miękka linia wygranej: przezroczysty → biały → przezroczysty w poprzek (04 § 2.16)
+  for (const [name, h, core] of [['lineCore', 32, 0.35], ['lineGlow', 64, 0.05]]) {
+    const c = makeCanvas(16, h);
+    const x = c.getContext('2d');
+    x.fillStyle = linear(x, 0, 0, 0, h, [[0, 'rgba(255,255,255,0)'], [0.5 - core / 2, 'rgba(255,255,255,0.9)'], [0.5, '#fff'], [0.5 + core / 2, 'rgba(255,255,255,0.9)'], [1, 'rgba(255,255,255,0)']]);
+    x.fillRect(0, 0, 16, h);
+    tex[name] = canvasTexture(PIXI, c);
+  }
+  // pionowy gradient (słup światła, smugi prędkości, połysk lądowania): biały na środku, zanik na końcach
+  {
+    const c = makeCanvas(64, 256);
+    const x = c.getContext('2d');
+    x.fillStyle = linear(x, 0, 0, 64, 0, [[0, 'rgba(255,255,255,0)'], [0.5, 'rgba(255,255,255,1)'], [1, 'rgba(255,255,255,0)']]);
+    x.fillRect(0, 0, 64, 256);
+    x.globalCompositeOperation = 'destination-in';
+    x.fillStyle = linear(x, 0, 0, 0, 256, [[0, 'rgba(0,0,0,0)'], [0.2, 'rgba(0,0,0,1)'], [0.8, 'rgba(0,0,0,1)'], [1, 'rgba(0,0,0,0)']]);
+    x.fillRect(0, 0, 64, 256);
+    tex.column = canvasTexture(PIXI, c);
+  }
+  // gradient „walca” (04 § 2.14): czarny u góry → przezroczysty
+  {
+    const c = makeCanvas(4, 128);
+    const x = c.getContext('2d');
+    x.fillStyle = linear(x, 0, 0, 0, 128, [[0, 'rgba(0,0,0,1)'], [1, 'rgba(0,0,0,0)']]);
+    x.fillRect(0, 0, 4, 128);
+    tex.fade = canvasTexture(PIXI, c);
+  }
+  // pozioma smuga (pas połysku lądowania, impuls siatki S1)
+  {
+    const c = makeCanvas(256, 32);
+    const x = c.getContext('2d');
+    x.fillStyle = linear(x, 0, 0, 0, 32, [[0, 'rgba(255,255,255,0)'], [0.5, 'rgba(255,255,255,1)'], [1, 'rgba(255,255,255,0)']]);
+    x.fillRect(0, 0, 256, 32);
+    x.globalCompositeOperation = 'destination-in';
+    x.fillStyle = linear(x, 0, 0, 256, 0, [[0, 'rgba(0,0,0,0)'], [0.25, 'rgba(0,0,0,1)'], [0.75, 'rgba(0,0,0,1)'], [1, 'rgba(0,0,0,0)']]);
+    x.fillRect(0, 0, 256, 32);
+    tex.band = canvasTexture(PIXI, c);
+  }
+  return tex;
+}
+
+/** Promienie (god rays) — 22 miękkie snopy z centrum, zanik do czerni przed krawędzią (brief: g_fx_promienie). */
+export function drawRays(PIXI, size = 1024, count = 22) {
+  const c = makeCanvas(size, size);
+  const x = c.getContext('2d');
+  const r = size / 2;
+  x.translate(r, r);
+  for (let i = 0; i < count; i++) {
+    const a = (i / count) * Math.PI * 2 + (i % 3) * 0.03;
+    const spread = (i % 2 ? 0.05 : 0.085) * Math.PI;
+    x.fillStyle = radial(x, 0, 0, 0, r, [[0, 'rgba(255,255,255,0.95)'], [0.35, 'rgba(255,255,255,0.45)'], [1, 'rgba(255,255,255,0)']]);
+    x.beginPath();
+    x.moveTo(0, 0);
+    x.arc(0, 0, r, a - spread / 2, a + spread / 2);
+    x.closePath();
+    x.fill();
+  }
+  x.globalCompositeOperation = 'lighter';
+  x.fillStyle = radial(x, 0, 0, 0, r * 0.35, [[0, 'rgba(255,255,255,0.7)'], [1, 'rgba(255,255,255,0)']]);
+  x.fillRect(-r, -r, size, size);
+  return canvasTexture(PIXI, c);
+}
+
+/** Flara: gwiazda z anamorficzną smugą (04 § 2.9, g_fx_flara). */
+export function drawFlare(PIXI, size = 512) {
+  const c = makeCanvas(size, size);
+  const x = c.getContext('2d');
+  const r = size / 2;
+  x.globalCompositeOperation = 'lighter';
+  x.fillStyle = radial(x, r, r, 0, r * 0.5, [[0, 'rgba(255,255,255,1)'], [0.2, 'rgba(255,255,255,0.6)'], [1, 'rgba(255,255,255,0)']]);
+  x.fillRect(0, 0, size, size);
+  for (const [w, h, a] of [[r, r * 0.035, 0], [r * 0.7, r * 0.025, Math.PI / 2], [r * 0.45, r * 0.02, Math.PI / 4], [r * 0.45, r * 0.02, -Math.PI / 4]]) {
+    x.save();
+    x.translate(r, r);
+    x.rotate(a);
+    x.fillStyle = radial(x, 0, 0, 0, w, [[0, 'rgba(255,255,255,0.95)'], [1, 'rgba(255,255,255,0)']]);
+    x.beginPath();
+    x.ellipse(0, 0, w, h, 0, 0, Math.PI * 2);
+    x.fill();
+    x.restore();
+  }
+  return canvasTexture(PIXI, c);
+}
+
+/** Piorun: łamana z jasnym rdzeniem i poświatą (04 § 2.10; tekstura pionowa, kotwica u góry). */
+export function drawLightning(PIXI, variant = 0, w = 96, h = 512) {
+  const c = makeCanvas(w, h);
+  const x = c.getContext('2d');
+  let seed = 31 + variant * 97;
+  const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
+  const pts = [[w / 2, 0]];
+  const n = 14;
+  for (let i = 1; i < n; i++) pts.push([w / 2 + (rnd() - 0.5) * w * 0.55, (i / n) * h]);
+  pts.push([w / 2, h]);
+  const path = () => {
+    x.beginPath();
+    pts.forEach(([px, py], i) => (i ? x.lineTo(px, py) : x.moveTo(px, py)));
+  };
+  x.lineJoin = 'round';
+  x.lineCap = 'round';
+  x.strokeStyle = 'rgba(255,255,255,0.35)';
+  x.shadowColor = '#fff';
+  x.shadowBlur = 18;
+  x.lineWidth = 9;
+  path();
+  x.stroke();
+  x.shadowBlur = 6;
+  x.strokeStyle = '#fff';
+  x.lineWidth = 3;
+  path();
+  x.stroke();
+  // odgałęzienie
+  x.lineWidth = 1.6;
+  x.beginPath();
+  const [bx, by] = pts[5];
+  x.moveTo(bx, by);
+  x.lineTo(bx + w * 0.3, by + h * 0.08);
+  x.lineTo(bx + w * 0.22, by + h * 0.16);
+  x.stroke();
+  return canvasTexture(PIXI, c);
+}
+
+/**
+ * Złoty napis 3D (banery BIG/MEGA/EPIC/ULTRA WIN, gdy brak `g_win_*` — 01 § 7.8, § 3.5).
+ * @param {{lines: string[], accent: string, accent2?: string, rainbow?: boolean}} o
+ */
+export function drawBanner(PIXI, { lines, accent = '#FFF3D1', accent2 = null, rainbow = false, font = 'Cinzel' }) {
+  const W = 960;
+  const H = 640;
+  const c = makeCanvas(W, H);
+  const x = c.getContext('2d');
+  x.textAlign = 'center';
+  x.textBaseline = 'alphabetic';
+  const sizes = lines.length === 1 ? [210] : [190, 230];
+  const ys = lines.length === 1 ? [H * 0.62] : [H * 0.44, H * 0.83];
+  lines.forEach((text, i) => {
+    const size = sizes[i];
+    x.font = `900 ${size}px "${font}", "Cinzel", Georgia, serif`;
+    // dopasowanie szerokości
+    const mw = x.measureText(text).width;
+    const scale = Math.min(1, (W * 0.9) / mw);
+    x.save();
+    x.translate(W / 2, ys[i]);
+    x.scale(scale, 1);
+    // poświata akcentu (kolor poziomu)
+    x.shadowColor = accent;
+    x.shadowBlur = 48;
+    x.fillStyle = accent;
+    x.globalAlpha = 0.55;
+    x.fillText(text, 0, 0);
+    if (accent2) {
+      x.shadowColor = accent2;
+      x.shadowBlur = 80;
+      x.fillText(text, 0, 0);
+    }
+    x.globalAlpha = 1;
+    x.shadowBlur = 0;
+    // wyciągnięcie 3D (ciemne złoto przesunięte w dół)
+    for (let d = 14; d > 0; d -= 2) {
+      x.fillStyle = d > 8 ? '#2B1A00' : '#5C3A00';
+      x.fillText(text, d * 0.25, d);
+    }
+    // lico: gradient złota albo tęcza (ULTRA)
+    x.fillStyle = rainbow
+      ? linear(x, -mw / 2, 0, mw / 2, 0, [[0, '#21E6FF'], [0.33, '#8F3DFF'], [0.66, '#FF2E88'], [1, '#FFE08A']])
+      : linear(x, 0, -size * 0.85, 0, size * 0.1, GOLD_STOPS);
+    x.fillText(text, 0, 0);
+    if (rainbow) {
+      x.globalCompositeOperation = 'source-atop';
+      x.fillStyle = linear(x, 0, -size * 0.85, 0, size * 0.1, [[0, 'rgba(255,255,255,0.75)'], [0.5, 'rgba(255,255,255,0.1)'], [1, 'rgba(0,0,0,0.25)']]);
+      x.fillText(text, 0, 0);
+      x.globalCompositeOperation = 'source-over';
+    }
+    x.lineWidth = 5;
+    x.strokeStyle = '#3D2700';
+    x.strokeText(text, 0, 0);
+    // połysk górnej połowy liter
+    x.save();
+    x.beginPath();
+    x.rect(-W, -size, W * 2, size * 0.45);
+    x.clip();
+    x.fillStyle = 'rgba(255,255,255,0.28)';
+    x.fillText(text, 0, 0);
+    x.restore();
+    x.lineWidth = 1.5;
+    x.strokeStyle = 'rgba(255,246,214,0.9)';
+    x.strokeText(text, 0, -2);
+    x.restore();
+  });
+  return canvasTexture(PIXI, c, { mipmap: true });
+}
+
+/**
+ * Złote cyfry (zastępstwo `g_font_cyfry`): atlas glifów 0–9 , + × i spacji o stałej szerokości cyfr
+ * (cyfry tabelaryczne — liczba nie „pływa” w poziomie, 04 § 2.17).
+ * @returns {{frames: Record<string, Texture>, advance: Record<string, number>, lineHeight: number, size: number}}
+ */
+export function buildGoldDigits(PIXI, size = 96) {
+  const chars = '0123456789,+×';
+  const font = `800 ${size}px "Manrope", "Segoe UI", system-ui, sans-serif`;
+  const probe = makeCanvas(8, 8).getContext('2d');
+  probe.font = font;
+  const digitW = Math.ceil(Math.max(...'0123456789'.split('').map((d) => probe.measureText(d).width)));
+  const cellW = digitW + 28;
+  const cellH = Math.ceil(size * 1.35);
+  const entries = chars.split('').map((ch) => ({
+    name: ch,
+    w: ch === ',' ? Math.ceil(size * 0.42) + 20 : ch === '+' || ch === '×' ? Math.ceil(size * 0.7) + 24 : cellW,
+    h: cellH,
+    draw(ctx, x, y, w, h) {
+      ctx.font = font;
+      ctx.textAlign = 'center';
+      ctx.textBaseline = 'alphabetic';
+      const bx = x + w / 2;
+      const by = y + size * 1.08;
+      ctx.shadowColor = 'rgba(245,197,66,0.75)';
+      ctx.shadowBlur = size * 0.16;
+      ctx.fillStyle = '#5C3A00';
+      ctx.fillText(ch, bx + 1, by + size * 0.05);
+      ctx.shadowBlur = 0;
+      ctx.fillStyle = '#2B1A00';
+      ctx.fillText(ch, bx + 1, by + size * 0.04);
+      ctx.fillStyle = linear(ctx, 0, by - size * 0.78, 0, by + size * 0.02, GOLD_STOPS);
+      ctx.fillText(ch, bx, by);
+      ctx.lineWidth = Math.max(2, size * 0.035);
+      ctx.strokeStyle = '#4A2F00';
+      ctx.strokeText(ch, bx, by);
+      ctx.save();
+      ctx.beginPath();
+      ctx.rect(x, y, w, by - size * 0.42 - y);
+      ctx.clip();
+      ctx.fillStyle = 'rgba(255,255,255,0.35)';
+      ctx.fillText(ch, bx, by);
+      ctx.restore();
+    },
+  }));
+  const atlas = buildAtlas(PIXI, entries, 1024);
+  const advance = {};
+  for (const e of entries) advance[e.name] = e.w - 16;
+  advance[' '] = Math.round(digitW * 0.35);
+  advance[' '] = advance[' '];   // spacja niełamliwa — separator tysięcy z format.js
+  return { frames: atlas.frames, advance, lineHeight: cellH, size };
+}
+
+/** Neonowy napis (Bungee): biały rdzeń, kontur magenta, poświata magenta + cyjan (01 § 9.4 — „×2”, „NEON JACKPOT”). */
+export function drawNeonText(PIXI, text, { size = 120, glow = true, core = '#FFFFFF', outline = '#FF2E88', halo = '#21E6FF' } = {}) {
+  const probe = makeCanvas(8, 8).getContext('2d');
+  const font = `400 ${size}px "Bungee", "Manrope", system-ui, sans-serif`;
+  probe.font = font;
+  const tw = probe.measureText(text).width;
+  const pad = size * 0.7;
+  const c = makeCanvas(tw + pad * 2, size * 1.25 + pad * 2);
+  const x = c.getContext('2d');
+  x.font = font;
+  x.textAlign = 'center';
+  x.textBaseline = 'middle';
+  const cx = c.width / 2;
+  const cy = c.height / 2 + size * 0.05;
+  if (glow) {
+    x.shadowColor = halo;
+    x.shadowBlur = size * 0.4;
+    x.fillStyle = halo;
+    x.globalAlpha = 0.6;
+    x.fillText(text, cx, cy);
+    x.shadowColor = outline;
+    x.shadowBlur = size * 0.2;
+    x.fillStyle = outline;
+    x.globalAlpha = 0.9;
+    x.fillText(text, cx, cy);
+    x.globalAlpha = 1;
+  }
+  x.shadowBlur = 0;
+  x.lineJoin = 'round';
+  x.lineWidth = Math.max(3, size * 0.07);
+  x.strokeStyle = outline;
+  x.strokeText(text, cx, cy);
+  x.fillStyle = core;
+  x.fillText(text, cx, cy);
+  return canvasTexture(PIXI, c, { mipmap: true });
+}
diff --git a/src/main/resources/static/js/game/core/easing.js b/src/main/resources/static/js/game/core/easing.js
new file mode 100644
index 0000000..8f0cc36
--- /dev/null
+++ b/src/main/resources/static/js/game/core/easing.js
@@ -0,0 +1,84 @@
+/**
+ * game/core/easing.js — funkcje wygładzania (easing) z docs/projekt/04-efekty-wizualne.md § 2.12.
+ *
+ * Po co własne: to kilkadziesiąt linii wzorów Roberta Pennera (easings.net). Biblioteka (GSAP, tween.js) dałaby
+ * to samo, ale student musi umieć obronić każdą linię, a nam potrzebne są dodatkowo `punch` i `hermite`
+ * (krzywa liczenia big win z § 4.2), których ogólne biblioteki nie mają.
+ * Każda funkcja przyjmuje t ∈ [0, 1] i zwraca postęp (przy funkcjach z odbiciem może wyjść poza 0…1).
+ */
+
+const { PI, cos, sin, sqrt, pow, exp } = Math;
+
+export const linear = (t) => t;
+export const easeInQuad = (t) => t * t;
+export const easeOutQuad = (t) => 1 - (1 - t) * (1 - t);
+export const easeInOutQuad = (t) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
+export const easeInCubic = (t) => t * t * t;
+export const easeOutCubic = (t) => 1 - (1 - t) ** 3;
+export const easeInOutCubic = (t) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
+export const easeOutQuart = (t) => 1 - (1 - t) ** 4;
+export const easeOutExpo = (t) => (t >= 1 ? 1 : 1 - pow(2, -10 * t));
+export const easeInOutSine = (t) => -(cos(PI * t) - 1) / 2;
+
+/**
+ * Wejście z odbiciem. Maksymalne przekroczenie = 4s³ / (27(s + 1)²): s = 1,70158 → 10%, s = 1,2 → 5,3%
+ * (wzór z 04 § 2.12 — dobieramy s do zamierzonego odbicia zamiast „na oko”).
+ */
+export const easeOutBack = (s = 1.70158) => (t) => 1 + (s + 1) * (t - 1) ** 3 + s * (t - 1) ** 2;
+export const easeInBack = (s = 1.70158) => (t) => (s + 1) * t * t * t - s * t * t;
+
+export const easeOutElastic = (t) =>
+  (t <= 0 || t >= 1 ? t : pow(2, -10 * t) * sin((10 * t - 0.75) * ((2 * PI) / 3)) + 1);
+
+export function easeOutBounce(t) {
+  const n = 7.5625;
+  const d = 2.75;
+  if (t < 1 / d) return n * t * t;
+  if (t < 2 / d) return n * (t -= 1.5 / d) * t + 0.75;
+  if (t < 2.5 / d) return n * (t -= 2.25 / d) * t + 0.9375;
+  return n * (t -= 2.625 / d) * t + 0.984375;
+}
+
+/**
+ * „Uderzenie” skali: 0 → 1 + a przy 45% czasu (easeOutCubic) → 1 przy 100% (easeInOutSine).
+ * Zwraca MNOŻNIK skali (1 na początku i końcu), nie postęp — używane jako `scale = base * punch(a)(t)`.
+ */
+export const punch = (a) => (t) => {
+  if (t < 0.45) return 1 + a * easeOutCubic(t / 0.45);
+  return 1 + a * (1 - easeInOutSine((t - 0.45) / 0.55));
+};
+
+/**
+ * Wielomian Hermite'a dla ostatniego segmentu liczenia big win (04 § 4.2):
+ * f(0) = 0, f(1) = 1, f'(0) = s0 (ciągłość prędkości z poprzednim segmentem), f'(1) = 0 (miękkie zatrzymanie).
+ * Dla s0 = 3 to dokładnie easeOutCubic; s0 ≤ 3 gwarantuje, że licznik nigdy się nie cofa.
+ */
+export const hermite = (s0) => {
+  const s = Math.min(3, Math.max(0, s0));
+  return (u) => s * (u * u * u - 2 * u * u + u) + (3 * u * u - 2 * u * u * u);
+};
+
+/**
+ * Tłumiona sprężyna: 1 − e^(−ζωt)·(cos(ω_d t) + (ζω/ω_d)·sin(ω_d t)). `tSec` w sekundach, wynik → 1.
+ * Do kopnięcia kamery i odbić UI (04 § 2.12).
+ */
+export function spring(zeta, freqHz, tSec) {
+  const w = 2 * PI * freqHz;
+  const wd = w * sqrt(1 - zeta * zeta);
+  return 1 - exp(-zeta * w * tSec) * (cos(wd * tSec) + ((zeta * w) / wd) * sin(wd * tSec));
+}
+
+export const clamp = (v, lo, hi) => (v < lo ? lo : v > hi ? hi : v);
+export const lerp = (a, b, t) => a + (b - a) * t;
+
+/** Mapa nazw → funkcji (oś czasu może podać easing jako tekst, np. 'easeOutCubic'). */
+export const EASINGS = {
+  linear, easeInQuad, easeOutQuad, easeInOutQuad, easeInCubic, easeOutCubic, easeInOutCubic, easeOutQuart,
+  easeOutExpo, easeInOutSine, easeOutBack: easeOutBack(), easeInBack: easeInBack(), easeOutElastic, easeOutBounce,
+};
+
+/** Zwraca funkcję wygładzania z nazwy albo samą funkcję (domyślnie liniowo). */
+export function resolveEasing(e) {
+  if (typeof e === 'function') return e;
+  return EASINGS[e] ?? linear;
+}
diff --git a/src/main/resources/static/js/game/core/pool.js b/src/main/resources/static/js/game/core/pool.js
new file mode 100644
index 0000000..e65d37c
--- /dev/null
+++ b/src/main/resources/static/js/game/core/pool.js
@@ -0,0 +1,44 @@
+/**
+ * game/core/pool.js — prosta pula obiektów (object pool).
+ *
+ * Po co: tworzenie i niszczenie sprite'ów w trakcie animacji (flary, pierścienie, pioruny przy każdej wygranej)
+ * zmusza przeglądarkę do sprzątania pamięci (garbage collection), a sprzątanie w trakcie Big Win to zacięcie
+ * klatki. Pula tworzy obiekty raz i potem je pożycza / przyjmuje z powrotem.
+ */
+export class Pool {
+  #free = [];
+  #create;
+  #reset;
+  created = 0;
+
+  /**
+   * @param {() => T} create fabryka nowego obiektu
+   * @param {(obj: T) => void} [reset] przywrócenie stanu domyślnego przy oddaniu
+   * @param {number} [prefill] ile obiektów utworzyć od razu (np. na ekranie ładowania)
+   * @template T
+   */
+  constructor(create, reset, prefill = 0) {
+    this.#create = create;
+    this.#reset = reset;
+    for (let i = 0; i < prefill; i++) this.#free.push(this.#make());
+  }
+
+  #make() {
+    this.created++;
+    return this.#create();
+  }
+
+  get() {
+    return this.#free.pop() ?? this.#make();
+  }
+
+  release(obj) {
+    if (!obj) return;
+    this.#reset?.(obj);
+    this.#free.push(obj);
+  }
+
+  get available() {
+    return this.#free.length;
+  }
+}
diff --git a/src/main/resources/static/js/game/core/quality.js b/src/main/resources/static/js/game/core/quality.js
new file mode 100644
index 0000000..7d96400
--- /dev/null
+++ b/src/main/resources/static/js/game/core/quality.js
@@ -0,0 +1,210 @@
+/**
+ * game/core/quality.js — poziomy jakości High / Medium / Low i tryb ograniczonego ruchu (brief § 5, 04 § 1.5, § 2.2).
+ *
+ * Dlaczego trzy poziomy i automat: ten sam automat ma działać płynnie na słabym telefonie i na monitorze 4K.
+ * Zamiast zgadywać możliwości sprzętu, mierzymy czas klatki: gdy 90. percentyl (p90) przekracza 20 ms przez 2 s
+ * (4 pomiary co 500 ms z rzędu), obniżamy poziom o jeden. Gracz może też wybrać poziom ręcznie (wyłącza automat).
+ *
+ * Co zmienia się od razu (limit cząsteczek, drżenie, filtry), a co dopiero między rundami (rozdzielczość DPR) —
+ * zmiana ostrości w trakcie spinu byłaby widocznym „skokiem” obrazu (04 § 2.2).
+ */
+
+const STORAGE_KEY = 'cebulion.jakosc';
+const MOTION_KEY = 'cebulion.ruch';
+
+/** Parametry poziomów — wartości z briefu § 5 i 04 § 2.2 (tabela „Poziomy jakości”). */
+export const LEVELS = Object.freeze({
+  high: Object.freeze({
+    name: 'high', index: 0, dpr: 2, particles: 600, bloom: 'filter', shake: true, filters: true,
+    raysLayers: 2, raysScale: 1.6, raysBAlpha: 0.5, smoke: 12, shine: 'shader', confetti: 220, bgFx: 1, lightning: 3,
+  }),
+  medium: Object.freeze({
+    name: 'medium', index: 1, dpr: 1.5, particles: 300, bloom: 'baked', shake: true, filters: false,
+    raysLayers: 2, raysScale: 1.3, raysBAlpha: 0.3, smoke: 6, shine: 'shader', confetti: 110, bgFx: 0.5, lightning: 2,
+  }),
+  low: Object.freeze({
+    name: 'low', index: 2, dpr: 1, particles: 120, bloom: 'none', shake: false, filters: false,
+    raysLayers: 1, raysScale: 1.1, raysBAlpha: 0, smoke: 2, shine: 'syl', confetti: 40, bgFx: 0, lightning: 1,
+  }),
+});
+const ORDER = ['high', 'medium', 'low'];
+
+const storage = {
+  get(k) { try { return localStorage.getItem(k); } catch { return null; } },
+  set(k, v) { try { localStorage.setItem(k, v); } catch { /* tryb prywatny */ } },
+};
+
+/** Poziom startowy (04 § 2.2): komputer High, ekran dotykowy Medium, mało pamięci / oszczędzanie danych Low. */
+function initialLevel() {
+  const mem = navigator.deviceMemory;
+  const saveData = navigator.connection?.saveData;
+  if ((mem && mem <= 2) || saveData) return 'low';
+  if (matchMedia('(pointer: coarse)').matches) return 'medium';
+  return 'high';
+}
+
+export class Quality extends EventTarget {
+  /** 'auto' albo nazwa poziomu wybranego ręcznie. */
+  mode = 'auto';
+  level = 'high';
+  #samples = new Float32Array(120);
+  #scratch = new Float32Array(120);
+  #count = 0;
+  #head = 0;
+  #sinceCheck = 0;
+  #badChecks = 0;
+  #goodMs = 0;
+  #suspendMs = 0;
+  #lastChangeAt = -Infinity;
+  #downgrades = { high: 0, medium: 0, low: 0 };
+  #clockMs = 0;
+  /** Ostatnio policzony p90 (ms) — panel debug i raport e2e. */
+  p90 = 0;
+  fps = 60;
+  /** Historia zmian (raport e2e). */
+  log = [];
+
+  constructor() {
+    super();
+    const saved = storage.get(STORAGE_KEY);
+    if (saved && (saved === 'auto' || LEVELS[saved])) this.mode = saved;
+    this.level = this.mode === 'auto' ? initialLevel() : this.mode;
+  }
+
+  get params() {
+    return LEVELS[this.level];
+  }
+
+  /** Wybiera wartość dla bieżącego poziomu z trójki [High, Medium, Low] (karty zdarzeń w 04 podają takie trójki). */
+  pick(triple) {
+    return Array.isArray(triple) ? triple[this.params.index] ?? triple.at(-1) : triple;
+  }
+
+  /** Ręczny wybór: 'auto' | 'high' | 'medium' | 'low'. */
+  setMode(mode) {
+    if (mode !== 'auto' && !LEVELS[mode]) return;
+    this.mode = mode;
+    storage.set(STORAGE_KEY, mode);
+    this.#setLevel(mode === 'auto' ? this.level : mode, 'manual');
+  }
+
+  /** Wstrzymuje pomiar (ekran ładowania, wgrywanie tekstur, przejścia — zawyżają czasy klatek). */
+  suspend(ms) {
+    this.#suspendMs = Math.max(this.#suspendMs, ms);
+    this.#count = 0;
+    this.#badChecks = 0;
+  }
+
+  /** Wywoływane co klatkę z czasem klatki w ms (04 § 7.3, krok 8). */
+  sample(frameMs) {
+    this.#clockMs += frameMs;
+    if (this.#suspendMs > 0) {
+      this.#suspendMs -= frameMs;
+      return;
+    }
+    this.#samples[this.#head] = frameMs;
+    this.#head = (this.#head + 1) % this.#samples.length;
+    this.#count = Math.min(this.#count + 1, this.#samples.length);
+    this.#sinceCheck += frameMs;
+    if (this.#sinceCheck < 500) return;
+    this.#sinceCheck = 0;
+    this.p90 = this.#percentile(0.9);
+    const p50 = this.#percentile(0.5);
+    this.fps = p50 > 0 ? Math.round(1000 / p50) : 60;
+    if (this.mode !== 'auto' || this.#count < 30) return;
+    // obniżenie: p90 > 20 ms w 4 kolejnych pomiarach (= 2 s)
+    if (this.p90 > 20) {
+      this.#goodMs = 0;
+      if (++this.#badChecks >= 4) {
+        this.#badChecks = 0;
+        this.#step(+1, `p90 ${this.p90.toFixed(1)} ms > 20 ms przez 2 s`);
+      }
+    } else {
+      this.#badChecks = 0;
+      this.#goodMs = this.p90 < 12 ? this.#goodMs + 500 : 0;
+    }
+  }
+
+  /**
+   * Podwyższenie poziomu — tylko między rundami (woła je kontroler, gdy gra czeka na SPIN):
+   * p90 < 12 ms przez 20 s, najwyżej raz na 2 min, bez powrotu na poziom, z którego dwa razy spadliśmy.
+   */
+  maybeUpgrade() {
+    if (this.mode !== 'auto' || this.#goodMs < 20_000) return;
+    if (this.#clockMs - this.#lastChangeAt < 120_000) return;
+    const target = ORDER[ORDER.indexOf(this.level) - 1];
+    if (!target || this.#downgrades[target] >= 2) return;
+    this.#goodMs = 0;
+    this.#setLevel(target, `p90 ${this.p90.toFixed(1)} ms < 12 ms przez 20 s`);
+  }
+
+  #step(dir, reason) {
+    const i = ORDER.indexOf(this.level) + dir;
+    if (i < 0 || i >= ORDER.length) return;
+    if (dir > 0) this.#downgrades[this.level] += 1;
+    this.#setLevel(ORDER[i], reason);
+  }
+
+  #setLevel(level, reason) {
+    if (!LEVELS[level]) return;
+    const changed = level !== this.level;
+    this.level = level;
+    this.#lastChangeAt = this.#clockMs;
+    this.#count = 0;
+    this.#badChecks = 0;
+    if (changed || reason === 'manual') {
+      this.log.push({ at: Math.round(this.#clockMs), level, reason });
+      this.dispatchEvent(new CustomEvent('change', { detail: { level, reason } }));
+    }
+  }
+
+  #percentile(p) {
+    const n = this.#count;
+    if (!n) return 0;
+    const a = this.#scratch.subarray(0, n);
+    a.set(this.#samples.subarray(0, n));
+    a.sort();
+    return a[Math.min(n - 1, Math.floor(p * n))];
+  }
+}
+
+/**
+ * Ograniczenie ruchu (04 § 1.5): system (`prefers-reduced-motion`) albo przełącznik gracza.
+ * Wyłącza błyski i drżenie, zmniejsza liczbę i prędkość cząsteczek, zastępuje „uderzenia” przenikaniem.
+ */
+export class Motion extends EventTarget {
+  #media = matchMedia('(prefers-reduced-motion: reduce)');
+  /** 'auto' (jak system) | 'reduced' | 'full' */
+  setting = storage.get(MOTION_KEY) ?? 'auto';
+
+  constructor() {
+    super();
+    this.#media.addEventListener('change', () => this.#emit());
+  }
+
+  get reduced() {
+    return this.setting === 'reduced' || (this.setting === 'auto' && this.#media.matches);
+  }
+
+  /** Mnożnik liczby cząsteczek (RM: × 0,3). */
+  get particleMul() {
+    return this.reduced ? 0.3 : 1;
+  }
+
+  /** Mnożnik prędkości cząsteczek (RM: × 0,6). */
+  get speedMul() {
+    return this.reduced ? 0.6 : 1;
+  }
+
+  set(value) {
+    this.setting = value;
+    storage.set(MOTION_KEY, value);
+    document.documentElement.classList.toggle('ruch-ograniczony', this.reduced);
+    this.#emit();
+  }
+
+  #emit() {
+    document.documentElement.classList.toggle('ruch-ograniczony', this.reduced);
+    this.dispatchEvent(new CustomEvent('change', { detail: { reduced: this.reduced } }));
+  }
+}
diff --git a/src/main/resources/static/js/game/core/random.js b/src/main/resources/static/js/game/core/random.js
new file mode 100644
index 0000000..6a20c79
--- /dev/null
+++ b/src/main/resources/static/js/game/core/random.js
@@ -0,0 +1,69 @@
+/**
+ * game/core/random.js — deterministyczny generator liczb losowych efektów (04 § 1.2, reguła R10).
+ *
+ * Po co: kierunki iskier, rozrzut monet i kolejność migotań pochodzą z generatora z ziarnem wyliczonym
+ * z `roundId`. Ta sama runda wygląda zawsze tak samo — powtarzalne nagrania do lobby i porównywanie zrzutów.
+ * UWAGA: to losowość WYŁĄCZNIE dla wyglądu. Wynik gry losuje serwer (front niczego nie losuje — kontrakt 09 § 2.4).
+ */
+
+/** FNV-1a (32 bity) — szybki skrót tekstu do ziarna. */
+export function fnv1a(text) {
+  let h = 0x811c9dc5;
+  for (let i = 0; i < text.length; i++) {
+    h ^= text.charCodeAt(i);
+    h = Math.imul(h, 0x01000193);
+  }
+  return h >>> 0;
+}
+
+/** Generator mulberry32: 32-bitowy stan, okres 2³², jakość wystarczająca do efektów. */
+export class Rng {
+  constructor(seed = Date.now()) {
+    this.state = seed >>> 0;
+  }
+
+  /** Nowe ziarno z tekstu (np. `${roundId}:${numerZdarzenia}`). */
+  reseed(text) {
+    this.state = fnv1a(String(text));
+    return this;
+  }
+
+  /** Liczba z [0, 1). */
+  next() {
+    let t = (this.state = (this.state + 0x6d2b79f5) >>> 0);
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  }
+
+  range(a, b) {
+    return a + (b - a) * this.next();
+  }
+
+  int(a, b) {
+    return Math.floor(this.range(a, b + 1));
+  }
+
+  pick(list) {
+    return list[Math.floor(this.next() * list.length)];
+  }
+
+  sign() {
+    return this.next() < 0.5 ? -1 : 1;
+  }
+}
+
+/** Wspólny generator efektów (ziarno ustawia odtwarzacz kroków na początku każdej rundy). */
+export const fxRng = new Rng(0xceb0777);
+
+/**
+ * Skrót całkowity z indeksu (stabilny „losowy” symbol taśmy bębna dla danej pozycji — taśma nie migocze,
+ * bo ta sama pozycja zawsze daje ten sam symbol).
+ */
+export function hashInt(a, b = 0) {
+  let h = Math.imul(a ^ 0x9e3779b9, 0x85ebca6b) ^ Math.imul(b + 0x27d4eb2f, 0xc2b2ae35);
+  h ^= h >>> 15;
+  h = Math.imul(h, 0x2c1b3c6d);
+  h ^= h >>> 12;
+  return (h >>> 0) / 4294967296;
+}
diff --git a/src/main/resources/static/js/game/core/resources.js b/src/main/resources/static/js/game/core/resources.js
new file mode 100644
index 0000000..3165210
--- /dev/null
+++ b/src/main/resources/static/js/game/core/resources.js
@@ -0,0 +1,123 @@
+/**
+ * game/core/resources.js — tekstury gry po ID z manifestu (kontrakt 09 § 3) z paskiem postępu (04 E20).
+ *
+ * Zasady:
+ *   * kod gry prosi o obraz przez ID (`s1_sym_wild`) i opcjonalnie wariant (`glow`, `ruch1`, `ruch2`, `syl`, `cien`,
+ *     `male`) — nigdy przez ścieżkę; podmiana grafiki zastępczej na tę z ChatGPT nie wymaga zmian w kodzie,
+ *   * brak manifestu, brak ID albo błąd pobrania pliku = `null`, bez wyjątku — gra rysuje wtedy grafikę z kodu
+ *     (js/game/core/canvas-art.js, js/game/games/s1-art.js), a nie szare kwadraty,
+ *   * @1x / @2x wybieramy według gęstości ekranu i poziomu jakości (Low = zawsze @1x, 04 § 2.2); tła — według
+ *     szerokości z pola `widths` (najmniejszy wariant nie mniejszy niż ekran).
+ */
+
+import { assets } from '../../assets.js';
+
+export class Resources {
+  #textures = new Map();     // klucz `${id}|${wariant}` → Texture
+  #gameApp;
+
+  constructor(gameApp) {
+    this.#gameApp = gameApp;
+  }
+
+  get PIXI() {
+    return this.#gameApp.PIXI;
+  }
+
+  /** Wczytuje manifest obrazów (nigdy nie odrzuca — brak = pusty manifest). */
+  async loadManifest() {
+    await assets.load();
+  }
+
+  /** Okno ramki bębnów z manifestu (`frames.<ID>.window`, ułamki) albo null. */
+  frameWindow(id) {
+    return assets.section('frames')?.[id]?.window ?? null;
+  }
+
+  /** Metryki fontu bitmapowego (np. `CebulionCyfry` z obróbki `g_font_cyfry`) albo null. */
+  font(name) {
+    return assets.section('fonts')?.[name] ?? null;
+  }
+
+  /** Wpis manifestu (do proporcji wariantów: glow jest większy od symbolu o margines poświaty). */
+  entry(id) {
+    return assets.entry(id);
+  }
+
+  has(id, variant = null) {
+    return this.#textures.has(`${id}|${variant ?? ''}`);
+  }
+
+  /** Tekstura albo null. */
+  texture(id, variant = null) {
+    return this.#textures.get(`${id}|${variant ?? ''}`) ?? null;
+  }
+
+  /** Rejestruje teksturę wygenerowaną w kodzie (np. zastępczy symbol), żeby reszta kodu pytała jednym API. */
+  register(id, variant, texture) {
+    this.#textures.set(`${id}|${variant ?? ''}`, texture);
+  }
+
+  /**
+   * Adres pliku dla ID (i wariantu) albo null.
+   * @param {{targetWidth?: number}} o targetWidth — potrzebna szerokość w pikselach urządzenia (tła)
+   */
+  urlFor(id, variant = null, { targetWidth } = {}) {
+    const e = assets.entry(id);
+    if (!e) return null;
+    const hiDpi = (window.devicePixelRatio || 1) > 1.2 && this.#gameApp.quality.level !== 'low';
+    if (variant) {
+      const v = e.variants?.[variant];
+      if (!v?.src) return null;
+      return assets.url(hiDpi && v.src2x ? v.src2x : v.src);
+    }
+    if (targetWidth && e.widths) {
+      const options = Object.entries(e.widths).map(([w, src]) => [Number(w), src]).sort((a, b) => a[0] - b[0]);
+      const pick = options.find(([w]) => w >= targetWidth) ?? options.at(-1);
+      if (pick) return assets.url(pick[1]);
+    }
+    return assets.url(hiDpi && e.src2x ? e.src2x : e.src);
+  }
+
+  /**
+   * Ładuje listę obrazów z postępem.
+   * @param {Array<{id: string, variant?: string, targetWidth?: number}>} requests
+   * @param {(p: number) => void} onProgress 0…1
+   */
+  async load(requests, onProgress) {
+    const { Assets } = this.PIXI;
+    const jobs = requests
+      .map((r) => ({ ...r, url: this.urlFor(r.id, r.variant, r) }))
+      .filter((r) => r.url && !this.has(r.id, r.variant));
+    if (!jobs.length) {
+      onProgress?.(1);
+      return;
+    }
+    let done = 0;
+    // pojedynczo (nie jedną paczką): błąd jednego pliku nie może zablokować reszty — brak pliku = grafika z kodu
+    await Promise.all(jobs.map(async (job) => {
+      try {
+        const texture = await Assets.load({ alias: `${job.id}|${job.variant ?? ''}`, src: job.url });
+        if (texture?.source) this.#textures.set(`${job.id}|${job.variant ?? ''}`, texture);
+      } catch {
+        console.warn(`[zasoby] nie udało się wczytać ${job.id}${job.variant ? '.' + job.variant : ''} — używam grafiki z kodu`);
+      } finally {
+        done += 1;
+        onProgress?.(done / jobs.length);
+      }
+    }));
+  }
+
+  /** Lista ID komórek arkusza (np. 'g_fx_iskry' → ['g_fx_iskry__0', …]) obecnych w manifeście. */
+  sheetCells(sheetId) {
+    const cells = assets.section('sheets')?.[sheetId]?.cells;
+    if (!Array.isArray(cells)) return [];
+    return cells.map((c) => `${sheetId}__${c}`).filter((id) => assets.entry(id));
+  }
+}
+
+/** Czeka na fonty używane w grafice rysowanej w kodzie (Canvas 2D potrzebuje wczytanego fontu). */
+export async function ensureFonts(specs) {
+  if (!document.fonts?.load) return;
+  await Promise.all(specs.map((s) => document.fonts.load(s).catch(() => null)));
+}
diff --git a/src/main/resources/static/js/game/core/tween.js b/src/main/resources/static/js/game/core/tween.js
new file mode 100644
index 0000000..5085626
--- /dev/null
+++ b/src/main/resources/static/js/game/core/tween.js
@@ -0,0 +1,262 @@
+/**
+ * game/core/tween.js — zegar gry, animacje właściwości (tweeny), oczekiwanie i oś czasu (04 § 2.1, § 7.3).
+ *
+ * Trzy pojęcia, które student powinien umieć wyjaśnić:
+ *   * Zegar gry płynie tylko wtedy, gdy działa ticker Pixi. Karta ukryta → ticker stoi → stoją też animacje
+ *     i oczekiwania (`wait`). Dzięki temu po powrocie do karty nic nie „przeskakuje”.
+ *   * Dwa czasy: `dt` (zwykły) i `fxDt` (zamrażany przez *hit-stop* — 80 ms „stopklatki” przy eskalacji big win,
+ *     04 E31). Tween z opcją `freeze: true` stoi w czasie stopklatki, reszta (kamera, muzyka) biegnie dalej.
+ *   * Przewinięcie (skip): `SkipToken` przekazany do `wait`/`tween` kończy je natychmiast. Sekwencje wygranych
+ *     same decydują, jak wygląda ich stan końcowy — token tylko „budzi” czekające obietnice.
+ *
+ * Wydajność: obiekty tweenów pochodzą z puli i wracają do niej po zakończeniu (zero alokacji w pętli gry
+ * poza obietnicami, które tworzymy tylko na żądanie przez `.promise`).
+ */
+
+import { resolveEasing } from './easing.js';
+
+/** Token przewinięcia: `skip()` budzi wszystkie oczekiwania, które go dostały. */
+export class SkipToken {
+  #listeners = new Set();
+  skipped = false;
+
+  skip() {
+    if (this.skipped) return;
+    this.skipped = true;
+    for (const fn of [...this.#listeners]) fn();
+    this.#listeners.clear();
+  }
+
+  /** Rejestruje funkcję wywoływaną przy przewinięciu; zwraca funkcję wypisania. */
+  onSkip(fn) {
+    if (this.skipped) {
+      fn();
+      return () => {};
+    }
+    this.#listeners.add(fn);
+    return () => this.#listeners.delete(fn);
+  }
+}
+
+/** Jeden aktywny tween (obiekt z puli). */
+class Tween {
+  reset() {
+    this.elapsed = 0;
+    this.delay = 0;
+    this.duration = 0;
+    this.ease = null;
+    this.onUpdate = null;
+    this.onComplete = null;
+    this.freeze = false;
+    this.target = null;
+    this.alive = false;
+    this.resolve = null;
+    this.promiseObj = null;
+    this.unSkip = null;
+    this.tag = null;
+  }
+
+  /** Obietnica zakończenia (tworzona leniwie — większość tweenów nikt nie „await”-uje). */
+  get promise() {
+    if (!this.alive) return Promise.resolve();
+    this.promiseObj ??= new Promise((r) => { this.resolve = r; });
+    return this.promiseObj;
+  }
+}
+
+export class Tweener {
+  #active = [];
+  #pool = [];
+  /** Czas gry w ms od startu (płynie tylko, gdy ticker działa). */
+  now = 0;
+  /** Czas efektów (stoi w czasie hit-stop). */
+  fxNow = 0;
+  #hitStop = 0;
+
+  /** Pozostały czas stopklatki (ms). */
+  get hitStopping() {
+    return this.#hitStop > 0;
+  }
+
+  /** Stopklatka: przez `ms` tweeny z `freeze: true` (licznik, cząsteczki) stoją. */
+  hitStop(ms) {
+    this.#hitStop = Math.max(this.#hitStop, ms);
+  }
+
+  /**
+   * Ogólny tween: co klatkę woła `onUpdate(eased, u)` przez `duration` ms.
+   * @param {number} duration ms
+   * @param {(e: number, u: number) => void} onUpdate
+   * @param {{ease?: string|Function, delay?: number, freeze?: boolean, onComplete?: Function, token?: SkipToken, target?: object, tag?: string}} o
+   * @returns {Tween}
+   */
+  tween(duration, onUpdate, o = {}) {
+    const tw = this.#pool.pop() ?? new Tween();
+    tw.reset();
+    tw.duration = Math.max(0, duration);
+    tw.delay = Math.max(0, o.delay ?? 0);
+    tw.ease = resolveEasing(o.ease);
+    tw.onUpdate = onUpdate;
+    tw.onComplete = o.onComplete ?? null;
+    tw.freeze = Boolean(o.freeze);
+    tw.target = o.target ?? null;
+    tw.tag = o.tag ?? null;
+    tw.alive = true;
+    if (o.token) tw.unSkip = o.token.onSkip(() => this.finish(tw));
+    this.#active.push(tw);
+    return tw;
+  }
+
+  /**
+   * Animacja właściwości obiektu Pixi: x, y, alpha, rotation, scale (liczba → scale.set), scaleX, scaleY, tint nie.
+   * @example tweener.to(sprite, { alpha: 0, scale: 1.2 }, { duration: 300, ease: 'easeOutCubic' })
+   */
+  to(target, props, o = {}) {
+    const keys = Object.keys(props);
+    const from = new Array(keys.length);
+    const to = new Array(keys.length);
+    let started = false;
+    const read = (k) => (k === 'scale' ? target.scale.x : k === 'scaleX' ? target.scale.x : k === 'scaleY' ? target.scale.y : target[k]);
+    const write = (k, v) => {
+      if (k === 'scale') target.scale.set(v);
+      else if (k === 'scaleX') target.scale.x = v;
+      else if (k === 'scaleY') target.scale.y = v;
+      else target[k] = v;
+    };
+    return this.tween(o.duration ?? 300, (e) => {
+      if (!started) {
+        // wartości startowe czytamy przy PIERWSZEJ klatce (po opóźnieniu), a nie w chwili wywołania —
+        // tak działa łańcuch kilku tweenów tego samego obiektu
+        started = true;
+        for (let i = 0; i < keys.length; i++) {
+          from[i] = read(keys[i]);
+          to[i] = props[keys[i]];
+        }
+      }
+      if (target.destroyed) return;
+      for (let i = 0; i < keys.length; i++) write(keys[i], from[i] + (to[i] - from[i]) * e);
+    }, { ...o, target });
+  }
+
+  /** Czeka `ms` czasu gry (albo do przewinięcia tokenem). */
+  wait(ms, o = {}) {
+    if (ms <= 0 || o.token?.skipped) return Promise.resolve();
+    return this.tween(ms, null, o).promise;
+  }
+
+  /** Kończy tween natychmiast (stan końcowy + onComplete). */
+  finish(tw) {
+    if (!tw?.alive) return;
+    tw.elapsed = tw.delay + tw.duration;
+    this.#step(tw, 0, true);
+  }
+
+  /** Zatrzymuje tween bez ustawiania stanu końcowego. */
+  kill(tw) {
+    if (!tw?.alive) return;
+    this.#release(tw);
+  }
+
+  /** Zatrzymuje tweeny danego obiektu (np. przed nową animacją tej samej właściwości). */
+  killTweensOf(target, { complete = false } = {}) {
+    for (const tw of this.#active) {
+      if (tw.alive && tw.target === target) complete ? this.finish(tw) : this.kill(tw);
+    }
+  }
+
+  killTag(tag, { complete = false } = {}) {
+    for (const tw of this.#active) {
+      if (tw.alive && tw.tag === tag) complete ? this.finish(tw) : this.kill(tw);
+    }
+  }
+
+  /** Wywoływane raz na klatkę przez pętlę gry (04 § 7.3, krok 4). */
+  update(dtMs) {
+    this.now += dtMs;
+    let fxDt = dtMs;
+    if (this.#hitStop > 0) {
+      const frozen = Math.min(this.#hitStop, dtMs);
+      this.#hitStop -= frozen;
+      fxDt = dtMs - frozen;
+    }
+    this.fxNow += fxDt;
+    this.lastFxDt = fxDt;
+    const list = this.#active;
+    // iteracja po kopii długości: tweeny dodane w trakcie klatki ruszą w następnej
+    const n = list.length;
+    for (let i = 0; i < n; i++) {
+      const tw = list[i];
+      if (tw.alive) this.#step(tw, tw.freeze ? fxDt : dtMs, false);
+    }
+    // kompaktowanie tablicy (usunięcie martwych) bez tworzenia nowej
+    let w = 0;
+    for (let i = 0; i < list.length; i++) if (list[i].alive) list[w++] = list[i];
+    list.length = w;
+  }
+
+  #step(tw, dt, force) {
+    tw.elapsed += dt;
+    const t = tw.elapsed - tw.delay;
+    if (t < 0 && !force) return;
+    const u = tw.duration > 0 ? Math.min(1, Math.max(0, t / tw.duration)) : 1;
+    if (tw.onUpdate) tw.onUpdate(tw.ease(u), u);
+    if (u >= 1) {
+      const done = tw.onComplete;
+      this.#release(tw);
+      done?.();
+    }
+  }
+
+  #release(tw) {
+    tw.alive = false;
+    tw.unSkip?.();
+    const resolve = tw.resolve;
+    tw.resolve = null;
+    tw.onUpdate = null;
+    tw.target = null;
+    resolve?.();
+    this.#pool.push(tw);
+  }
+
+  /** Liczba aktywnych tweenów (do panelu ?fx=debug). */
+  get count() {
+    return this.#active.length;
+  }
+}
+
+/**
+ * Oś czasu zdarzenia (OsCzasu z 04 § 2.1): lista `{ t, fn }` wykonywanych, gdy zegar osi minie `t`.
+ * `tempo` skaluje czasy (TURBO × 0,45), ale wpisy z `raw: true` (błyski — 04 § 1.4) zostają w czasie rzeczywistym.
+ */
+export class Timeline {
+  #events = [];
+  #tweener;
+  #tempo;
+
+  constructor(tweener, { tempo = 1 } = {}) {
+    this.#tweener = tweener;
+    this.#tempo = tempo;
+  }
+
+  /** Dodaje wpis; zwraca oś (łańcuch wywołań). */
+  at(t, fn, { raw = false } = {}) {
+    this.#events.push({ t: raw ? t : t * this.#tempo, fn });
+    return this;
+  }
+
+  /** Uruchamia oś; obietnica kończy się po ostatnim wpisie (albo przy przewinięciu). */
+  play({ token, extra = 0 } = {}) {
+    const events = this.#events.sort((a, b) => a.t - b.t);
+    const end = (events.at(-1)?.t ?? 0) + extra;
+    let i = 0;
+    let elapsed = 0;
+    const tw = this.#tweener.tween(end, (_e, u) => {
+      // po przewinięciu NIE odpalamy zaległych wpisów naraz (10 błysków w jednej klatce) — sekwencja
+      // sama ustawia swój stan końcowy
+      if (token?.skipped) return;
+      elapsed = u * end;
+      while (i < events.length && events[i].t <= elapsed + 0.001) events[i++].fn();
+    }, { token });
+    return tw.promise;
+  }
+}
diff --git a/src/main/resources/static/js/game/fx/bigwin.js b/src/main/resources/static/js/game/fx/bigwin.js
new file mode 100644
index 0000000..cc3e1ae
--- /dev/null
+++ b/src/main/resources/static/js/game/fx/bigwin.js
@@ -0,0 +1,523 @@
+/**
+ * game/fx/bigwin.js — sekwencja BIG / MEGA / EPIC / ULTRA WIN (04 § 4, karty E30, E31, E32).
+ *
+ * Przebieg: wejście (zasłona, dym, baner z uderzeniem, promienie) → liczenie od 0 przez kolejne progi (30×, 60×,
+ * 100× zakładu) z eskalacją poziomu na każdym progu (hit-stop 80 ms, błysk poziomu, nowy baner, basowe uderzenie,
+ * więcej monet) → slam kwoty końcowej → przytrzymanie → wyjście (licznik leci do pola „WYGRANA” w panelu).
+ *
+ * Krzywa liczenia (04 § 4.2): segmenty nieostatnie liniowo (pierwsze 300 ms easeInQuad), ostatni Hermite z s₀ =
+ * znormalizowana prędkość wejściowa (≤ 3) — licznik wjeżdża w ostatni segment z dotychczasową prędkością i łagodnie
+ * hamuje (zwykły easeOutCubic przyspieszyłby nagle ~3×, co wygląda jak błąd).
+ * Przewinięcie (04 § 4.5): ignorowane przez pierwsze 400 ms; w trakcie liczenia — skok do kwoty i JEDNA łączna
+ * eskalacja do poziomu końcowego; w trakcie przytrzymania — natychmiastowe wyjście.
+ */
+
+import { SkipToken, Timeline } from '../core/tween.js';
+import { KIND } from './particles.js';
+import { easeOutCubic, easeInOutSine, easeInCubic, easeInQuad, easeOutBack, hermite, punch, clamp } from '../core/easing.js';
+import { fxRng } from '../core/random.js';
+import { formatAmount } from '../../format.js';
+
+/**
+ * Poziomy: próg (× zakładu), baner, skala banera, błysk, trauma, promienie, akcent iskier (04 § 4.3, 01 § 3.5).
+ * Przyrosty traumy eskalacji (+0,50 / +0,60 / +0,75) są większe niż wejście BIG (0,45): trauma z E30 zdąży zgasnąć,
+ * a każda eskalacja ma trząść mocniej od poprzedniej (R2).
+ */
+export const LEVELS = [
+  { id: 'big', name: 'BIG WIN', at: 15, banner: 'g_win_big', scale: 1.0, flash: 'big', trauma: 0.45, omega: 4, tintA: 0xfff3d1, tintB: 0xfff3d1, spark: 0xffe08a, hold: 1500, rain: [36, 18, 9], fountain: [30, 16, 8] },
+  { id: 'mega', name: 'MEGA WIN', at: 30, banner: 'g_win_mega', scale: 1.06, flash: 'mega', trauma: 0.5, omega: 5.5, tintA: 0xffe08a, tintB: 0xff2e88, spark: 0xff2e88, hold: 1800, rain: [60, 30, 15], fountain: [40, 20, 10] },
+  { id: 'epic', name: 'EPIC WIN', at: 60, banner: 'g_win_epic', scale: 1.12, flash: 'epic', trauma: 0.6, omega: 7, tintA: 0xffe08a, tintB: 0x8f3dff, spark: 0x8f3dff, hold: 2100, rain: [85, 42, 21], fountain: [50, 25, 12] },
+  { id: 'ultra', name: 'ULTRA WIN', at: 100, banner: 'g_win_ultra', scale: 1.18, flash: 'ultra', trauma: 0.75, omega: 8, tintA: 0x21e6ff, tintB: 0xffffff, spark: 0x21e6ff, hold: 2600, rain: [110, 55, 27], fountain: [60, 30, 15], rainbow: true },
+];
+const TIER_INDEX = { big: 0, mega: 1, epic: 2, ultra: 3 };
+
+/**
+ * Segmenty liczenia (04 § 4.2) dla mnożnika m i poziomu końcowego.
+ * @returns {{from: number, to: number, dur: number, last: boolean, level: number}[]} wartości w × zakładu, czas w ms
+ */
+export function countSegments(m, finalLevel) {
+  const ends = [30, 60, 100];
+  const segs = [];
+  let from = 0;
+  for (let lv = 0; lv <= finalLevel; lv++) {
+    const last = lv === finalLevel;
+    const to = last ? m : ends[lv];
+    let dur;
+    if (lv === 0) dur = 2600 * (last ? clamp(m / 30, 0.6, 1) : 1);
+    else if (lv === 1) dur = 2400 * (last ? clamp((m - 30) / 30, 0.5, 1) : 1);
+    else if (lv === 2) dur = 2400 * (last ? clamp((m - 60) / 40, 0.5, 1) : 1);
+    else dur = clamp(2400 + 600 * Math.log2(Math.max(1, m / 100)), 2400, 4200);
+    segs.push({ from, to, dur, last, level: lv });
+    from = to;
+  }

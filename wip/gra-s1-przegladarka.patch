+/**
+ * game/audio/game-audio.js — zdarzenia gry → dźwięki (05 § 6.1, ID z briefu § 10).
+ *
+ * Jedno miejsce z mapowaniem zamiast `audio.play(…)` rozsianych po kodzie efektów: student pokazuje na obronie
+ * „tu jest tabela z 05, a tu ta sama tabela w kodzie”. Silnik (js/audio/audio-engine.js) zapewnia ciszę bez
+ * błędów, gdy pliku jeszcze nie ma — pipeline dźwięku dostarcza pliki do static/assets/audio/ niezależnie.
+ *
+ * Synchronizacja (R6 z 04): stopy bębnów planujemy na zegarze audio z wyprzedzeniem — bęben zapowiada stop
+ * ~170 ms wcześniej z dokładnym czasem (`approach`), a dźwięk dostaje `delay` co do milisekundy. WILD startuje
+ * 150 ms przed lądowaniem (punkt synchronizacji pliku `sfx_wild`, 05 § 3.3).
+ */
+
+import { audio } from '../../audio/audio-engine.js';
+
+/** Pakiety ładowania (05 § 2.4): krytyczne na ekranie ładowania, dalsze w tle po intro. */
+export const PACKS = {
+  critical: (g) => [
+    g.music, g.reelLoop, 'sfx_spin_start', 'sfx_beben_stop_1', 'sfx_beben_stop_2', 'sfx_beben_stop_3', 'sfx_beben_stop_4', 'sfx_beben_stop_5',
+    'sfx_wygrana_small_1', 'sfx_wygrana_small_2', 'sfx_wygrana_small_3', 'sfx_wygrana_medium', 'sfx_linia', 'sfx_licznik_tik',
+    'sfx_licznik_koniec', 'sfx_saldo_puls', 'sfx_wild', 'sfx_moneta_1', 'sfx_moneta_2', 'sfx_moneta_3', 'sfx_moneta_4', 'sfx_moneta_5',
+    'ui_klik', 'ui_przelacznik', 'ui_zaklad_gora', 'ui_zaklad_dol', 'ui_otworz', 'ui_zamknij', 'ui_blad', ...g.extraCritical,
+  ],
+  later: (g) => [
+    'sfx_bigwin_wejscie', 'sfx_poziom_w_gore', 'sfx_bigwin_koniec', 'mus_bigwin', 'sfx_monety_fontanna', 'sfx_blysk',
+    'sfx_uderzenie_basu', 'sfx_antycypacja_narastanie', 'sfx_bicie_serca', 'mus_napiecie', 'sfx_przejscie_whoosh', ...g.extraLater,
+  ],
+};
+
+export class GameAudio {
+  #loop = null;
+  #tick = null;
+  #fountain = null;
+  #heart = null;
+  #rise = null;
+  #resumeMusic = null;
+
+  /**
+   * @param {{music: string, reelLoop: string, reels: number, extraCritical?: string[], extraLater?: string[]}} game
+   */
+  constructor(game) {
+    this.game = { extraCritical: [], extraLater: [], ...game };
+    this.engine = audio;
+  }
+
+  preloadCritical() {
+    return audio.preload(PACKS.critical(this.game));
+  }
+
+  /** Pakiet dalszy: w tle, po intro (nigdy w trakcie spinu — dekodowanie zjada CPU). */
+  preloadLater() {
+    return audio.preload(PACKS.later(this.game));
+  }
+
+  // ------------------------------------------------------------------------------------- E21–E26
+
+  /** E21: muzyka gry z wejściem 1500 ms (stan CISZA → GRA, 05 § 4.5 przejście 4). */
+  intro() {
+    audio.playMusic(this.game.music, { fadeMs: 1500 });
+  }
+
+  /** E24 + E25: wciśnięcie SPIN i pętla obrotu po 40 ms (wejście 60 ms). Autoplay −6 dB. */
+  spinStart({ autoplay = false, free = false } = {}) {
+    if (!free) audio.play('sfx_spin_start', { volume: autoplay ? 0.5 : 1 });
+    this.#loop?.stop(60);
+    this.#loop = audio.play(this.game.reelLoop, { delay: 0.04, fadeIn: 60, volume: 1 });

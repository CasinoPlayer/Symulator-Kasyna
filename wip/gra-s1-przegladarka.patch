+  }
+
+  #uniquePositions(wins) {
+    const seen = new Set();
+    const out = [];
+    for (const w of wins) {
+      for (const [r, row] of w.positions ?? []) {
+        const k = `${r}:${row}`;
+        if (!seen.has(k)) {
+          seen.add(k);
+          out.push([r, row]);
+        }
+      }
+    }
+    return out;
+  }
+
+  /** Puls wygranej: 1,00 → 1,12 (160 ms, easeOutQuad) → 1,00 (260 ms, easeInOutSine) = 420 ms. */

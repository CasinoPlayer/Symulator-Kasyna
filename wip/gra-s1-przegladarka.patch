+  x.lineWidth = s * 0.006;
+  x.beginPath();
+  x.moveTo(len * 0.05, 0);
+  x.quadraticCurveTo(len * 0.5, -len * 0.06, len * 0.95, 0);
+  x.stroke();
+  x.restore();

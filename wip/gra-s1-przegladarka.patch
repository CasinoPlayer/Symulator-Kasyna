+    } else if (!big && m >= 1) {
+      for (const l of lifted) {
+        const c = this.reels.cellCenter(l.r, l.row);
+        this.particles.twinkles('fxAdd', c.x, c.y, this.reels.cell * 0.45, this.reels.cell * 0.45, this.particles.count([9, 6, 0]), { tint: 0xffe08a });

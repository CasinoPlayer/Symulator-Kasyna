+    }
+    if (this.bigwin.active) {
+      this.bigwin.skip();
+      return 'bigwin';
+    }
+    this.presentToken?.skip();
+    return 'present';
+  }
+
+  /** E40: łagodne zatrzymanie na planszy sprzed spinu. */

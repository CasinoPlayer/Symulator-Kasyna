+    this.logo.position.set(g.logo.x, g.logo.y);
+    const lt = this.logoBase.texture;
+    const ls = g.logo.w / Math.max(1, lt.width);
+    this.logoBase.scale.set(ls);
+    this.logoGlow.scale.set(ls * (this.logoGlowRatio ?? 1));
